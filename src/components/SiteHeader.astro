---
import { Image } from 'astro:assets';
import renuvamain from '../assets/images/RENUVAMAIN.png';
const { active = '' } = Astro.props;
const links = [
	{ href: '/about', label: 'About Us' },
	{ href: '/distributor', label: 'Distributor' },
	{ href: '/finishes', label: 'Finishes' },
	{ href: '/gallery', label: 'Gallery' },
	{ href: '/visualizer', label: 'Visualizer' },
];
---

<nav class="nav">
	<a class="logo" href="/" aria-label="Renuva">
		<Image src={renuvamain} alt="Renuva" width={550} loading="eager" />
	</a>
	<div class="nav-right">
		<div class="nav-links">
			{links.map((l) => (
				<a href={l.href} class={l.href === active ? 'active' : undefined}>{l.label}</a>
			))}
		</div>
		<a class="contact-btn" href="/contact">Contact Us</a>
	</div>
</nav>

<style>
	.nav {
		--nav-taupe: #8c7766;
		--nav-taupe-deep: #7a6657;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 36px clamp(24px, 5vw, 80px);
	}
	.logo { display: block; }
	.logo img { height: 48px; width: auto; display: block; }
	.nav-right { display: flex; align-items: center; gap: 40px; }
	.nav-links { display: flex; gap: 40px; }
	.nav-links a {
		font-family: 'Instrument Serif', serif;
		font-size: 21px;
		font-weight: 400;
		letter-spacing: normal;
		text-transform: none;
		color: #5e574e;
		text-decoration: none;
		padding: 0;
		border-radius: 0;
		background: none;
	}
	.nav-links a:hover {
		color: var(--nav-taupe);
		background: none;
		transform: none;
	}
	.nav-links a.active { color: var(--nav-taupe); }
	.contact-btn {
		font-family: 'Hanken Grotesk', sans-serif;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: normal;
		text-transform: none;
		color: #fff;
		background: linear-gradient(to bottom, #99836f, var(--nav-taupe));
		text-decoration: none;
		padding: 14px 28px;
		border-radius: 8px;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 0 #66554a, 0 5px 12px rgba(140, 119, 102, 0.3);
		transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}
	.contact-btn:hover {
		color: #fff;
		background: linear-gradient(to bottom, #8c7766, var(--nav-taupe-deep));
		transform: translateY(-1px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 3px 0 #66554a, 0 7px 16px rgba(140, 119, 102, 0.35);
	}
	.contact-btn:active {
		transform: translateY(1px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 1px 0 #66554a, 0 3px 8px rgba(140, 119, 102, 0.25);
	}

	@media (max-width: 1100px) {
		.nav-links { display: none; }
	}
</style>
