---
import { Image } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import Seo from '../components/Seo.astro';
import footerLogo from '../assets/images/LOGO_Colorful_Colorful_Colorful_White.png';

const shopUrl = 'https://surfacesupply.com/collections/renuva-architectural-film';

// The eight Renuva series, described from the finishes in each one (see
// public/scripts/renuva-finishes.js — the same data that fills the grid).
const series = [
	{
		name: 'Premium Wood',
		code: 'PW Series',
		count: 'Six finishes',
		body: 'The PW series is the natural wood range, from a pale cream ash with a subtle even figure to a deep reddish mahogany with straight, elegant grain. In between sit sandy, honey and amber oaks with fine cathedral figure, and a medium golden oak with straight rift-sawn grain. Designed for doors, cabinetry, millwork and furniture.',
	},
	{
		name: 'Painted Wood',
		code: 'RW Series',
		count: 'Four finishes',
		body: 'The RW series reads as painted timber rather than bare wood. Warm white carries visible brushstroke grain and a hand-painted character, cream has a subtle raised grain that reads as freshly lacquered joinery, and dove grey and bright white bring fine painted-timber and dense straight-grain texture. Designed for kitchens, cabinet fronts, wardrobes, doors and trim.',
	},
	{
		name: 'Marble',
		code: 'ST Series',
		count: 'Three finishes',
		body: 'The ST series brings stone to flat surfaces. Cream Onyx has soft, cloud-like veining and the gentle shifts of honed stone; Carrara White carries sparse, confident grey veining in the classic manner; Cloud White is denser and feathered, with polished-marble depth. Designed for feature walls, columns, reception desks, vanity surrounds and furniture.',
	},
	{
		name: 'Metal',
		code: 'ME Series',
		count: 'Two finishes',
		body: 'The ME series covers metallics. Brushed Champagne is a warm champagne-silver with fine hairline brushing running the length of the film, and Pearl Silver has a fine metallic stipple that catches light evenly. Designed for doors, panels, appliance surrounds, trim and fixtures in modern and commercial interiors.',
	},
	{
		name: 'Matte Solid',
		code: 'MT Series',
		count: 'Six finishes',
		body: 'The MT series is the plain-colour range, each with a smooth, finely textured matte surface. The tones run from pure white and soft white through ivory, pale grey and stone grey to a deep charcoal. Designed to refresh cabinets, doors, panels and built-ins in clean modern and neutral interiors.',
	},
	{
		name: 'High Gloss Solid',
		code: 'HG Series',
		count: 'Three finishes',
		body: 'The HG series pairs solid colour with a deep, reflective high-gloss finish: a crisp pure white, a warm ivory and a sophisticated greige. Designed to elevate modern kitchens, wardrobe fronts and feature panels.',
	},
	{
		name: 'Soft Matte',
		code: 'MTS Series',
		count: 'One finish',
		body: 'The MTS series is the super-matte end of the range. Slate Grey Soft Matte is an even mid-grey with a velvety soft-touch surface that diffuses light. Designed to bring a premium super-matte look to cabinet fronts, doors and built-ins.',
	},
	{
		name: 'Fabric',
		code: 'FP Series',
		count: 'Two finishes',
		body: 'The FP series carries woven texture at thread level. White Linen Weave is a crisp white with fine linen-weave texture, and Grey Linen Weave is a mid-grey with a natural vertical slub. Designed to soften wall panels, wardrobe fronts, headboard surrounds and hospitality interiors.',
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<Seo
			title="Finishes - Renuva"
			description="All 27 Renuva architectural film finishes across eight series — Premium Wood, Painted Wood, Marble, Metal, Matte Solid, High Gloss, Soft Matte and Fabric."
		/>
		<style is:global>
			:root {
				--paper: #F5F2EC;
				--taupe: #8C7766;
				--taupe-deep: #7A6657;
				--ink: #4B4540;
				--muted: #756E64;
				--card: #FDFCFA;
			}
			* { margin: 0; padding: 0; box-sizing: border-box; }
			html, body { overflow-x: clip; }
			body {
				background: var(--paper);
				font-family: 'Hanken Grotesk', sans-serif;
				color: var(--ink);
			}

			/* ============ PAGE COPY ============ */
			.fx-intro {
				padding: clamp(26px, 5vh, 52px) clamp(24px, 5vw, 84px) 0;
				text-align: center;
			}
			.fx-intro h1 {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(38px, 4.4vw, 64px);
				line-height: 1.02;
				letter-spacing: 0.005em;
				color: var(--taupe);
			}
			.fx-intro p {
				margin: 14px auto 0;
				max-width: 68ch;
				font-size: 16px;
				line-height: 1.75;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fx-series { padding: 0 clamp(24px, 5vw, 84px); }
			.fx-series-grid {
				max-width: 1040px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: clamp(20px, 2.6vw, 38px);
			}
			.fx-block {
				border-top: 1px solid rgba(75, 69, 64, 0.16);
				padding-top: 16px;
			}
			.fx-block h2 {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(26px, 2.4vw, 34px);
				line-height: 1.1;
				color: var(--taupe);
			}
			.fx-code {
				display: block;
				margin-top: 5px;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.fx-block p {
				margin-top: 11px;
				font-size: 15px;
				line-height: 1.7;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fx-buy {
				padding: clamp(30px, 5vh, 56px) clamp(24px, 5vw, 84px) clamp(56px, 8vh, 92px);
				text-align: center;
			}
			.fx-buy h2 {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(30px, 3vw, 44px);
				line-height: 1.05;
				color: var(--taupe);
			}
			.fx-buy p {
				margin: 12px auto 0;
				max-width: 58ch;
				font-size: 16px;
				line-height: 1.7;
				color: var(--muted);
			}
			.fx-buy a {
				color: var(--taupe-deep);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			/* ============ GRID — rows of 4 ============ */
			.fg-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: clamp(14px, 1.8vw, 26px);
				padding: clamp(28px, 4vh, 48px) clamp(24px, 5vw, 84px) clamp(70px, 10vh, 120px);
			}
			.fg-tile {
				position: relative;
				aspect-ratio: 4 / 5;
				border: 0;
				border-radius: 7px;
				overflow: hidden;
				background: #E8E2D8;
				cursor: pointer;
				box-shadow: 0 14px 36px rgba(75, 69, 64, 0.16);
				transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
				padding: 0;
			}
			.fg-tile:hover {
				transform: translateY(-5px) scale(1.015);
				box-shadow: 0 24px 54px rgba(75, 69, 64, 0.24);
			}
			.fg-tile img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				-webkit-user-drag: none;
				user-select: none;
			}
			/* subtle code, bottom-right */
			.fg-code {
				position: absolute;
				right: 12px;
				bottom: 10px;
				font-family: 'Hanken Grotesk', sans-serif;
				font-size: 10px;
				font-weight: 600;
				letter-spacing: 0.16em;
				color: rgba(75, 69, 64, 0.62);
				text-shadow: 0 1px 4px rgba(253, 252, 250, 0.55);
				pointer-events: none;
			}
			.fg-tile.is-dark .fg-code {
				color: rgba(253, 252, 250, 0.72);
				text-shadow: 0 1px 4px rgba(30, 26, 22, 0.45);
			}
			.fg-tile.is-origin { visibility: hidden; }

			/* ============ FOCUS OVERLAY — same UI as the Finish Library ============ */
			.fg-backdrop {
				position: fixed;
				inset: 0;
				background: #EFEAE1;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s ease;
				z-index: 1500;
			}
			body.fg-open .fg-backdrop { opacity: 0.97; pointer-events: auto; }

			.fg-focus {
				position: fixed;
				visibility: hidden;
				border-radius: 7px;
				overflow: hidden;
				background: #E8E2D8;
				cursor: pointer;
				box-shadow: 0 50px 130px rgba(75, 69, 64, 0.42);
				transition: transform 0.8s cubic-bezier(0.22, 0.8, 0.2, 1);
				will-change: transform;
				z-index: 2600;
			}
			.fg-focus img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				-webkit-user-drag: none;
				user-select: none;
			}

			/* detail panel — copied from the home-page Finish Library */
			.fin-detail {
				position: fixed;
				top: 50%;
				right: clamp(28px, 7vw, 130px);
				width: min(34vw, 400px);
				transform: translateY(-46%);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
				z-index: 2700;
			}
			body.fg-open .fin-detail {
				opacity: 1;
				transform: translateY(-50%);
				transition-delay: 0.35s;
				pointer-events: auto;
			}
			.fin-detail .fd-series {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.fin-detail h3 {
				margin-top: 10px;
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(40px, 3.6vw, 58px);
				line-height: 1.02;
				color: var(--taupe);
			}
			.fin-detail .fd-desc {
				margin-top: 16px;
				font-size: 15px;
				line-height: 1.6;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fin-detail .fd-specs {
				margin-top: 24px;
				border-top: 1px solid rgba(75, 69, 64, 0.16);
			}
			.fin-detail .fd-specs > div {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				padding: 11px 0;
				border-bottom: 1px solid rgba(75, 69, 64, 0.16);
				font-size: 14px;
			}
			.fin-detail .fd-specs dt { color: #998F82; }
			.fin-detail .fd-specs dd { font-weight: 600; color: var(--ink); text-align: right; white-space: nowrap; }
			.fin-detail .fd-link {
				display: inline-block;
				margin-top: 24px;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #fff;
				background: linear-gradient(to bottom, #99836F, var(--taupe));
				text-decoration: none;
				padding: 12px 20px;
				border-radius: 8px;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 0 #66554A, 0 5px 12px rgba(140, 119, 102, 0.3);
				transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
			}
			.fin-detail .fd-link:hover {
				background: linear-gradient(to bottom, var(--taupe), var(--taupe-deep));
				transform: translateY(-1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 3px 0 #66554A, 0 7px 16px rgba(140, 119, 102, 0.35);
			}
			.fin-detail .fd-link:active {
				transform: translateY(1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 1px 0 #66554A, 0 3px 8px rgba(140, 119, 102, 0.25);
			}

			.fin-close {
				position: fixed;
				top: 32px;
				right: 36px;
				width: 46px;
				height: 46px;
				border-radius: 50%;
				border: 1px solid rgba(75, 69, 64, 0.22);
				background: rgba(253, 252, 250, 0.9);
				color: #5E574E;
				font-size: 20px;
				line-height: 1;
				cursor: pointer;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease, background 0.3s ease;
				z-index: 3000;
			}
			body.fg-open .fin-close { opacity: 1; pointer-events: auto; }
			.fin-close:hover { background: #fff; }

			/* ============ FOOTER (matches home) ============ */
			footer {
				background: #554B43;
				color: #fff;
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}
			footer::before {
				content: "";
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.16), transparent 70%);
				pointer-events: none;
			}
			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}
			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}
			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.footer-logo { height: 44px; width: auto; display: block; }
			footer .footer-tagline {
				font-size: 0.9rem;
				font-weight: 400;
				color: rgba(255, 255, 255, 0.78);
			}
			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}
			.footer-nav { display: flex; gap: 1.2rem; flex-wrap: wrap; }
			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-size: 0.84rem;
				font-weight: 400;
				transition: color 0.3s;
			}
			.footer-nav a:hover { color: #fff; }
			footer .footer-copy {
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.45);
			}
			.footer-family {
				margin-top: 0.9rem;
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				text-align: center;
			}
			.footer-family a {
				color: rgba(255, 255, 255, 0.5);
				text-decoration: none;
				font-size: 0.76rem;
				font-weight: 400;
				transition: color 0.3s;
			}
			.footer-family a:hover { color: #fff; }

			@media (max-width: 1100px) {
				.fg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
				.fin-detail {
					right: 50%;
					transform: translate(50%, 0);
					top: auto;
					bottom: 22px;
					width: min(88vw, 420px);
					background: rgba(253, 252, 250, 0.95);
					border: 1px solid rgba(75, 69, 64, 0.1);
					border-radius: 14px;
					padding: 18px 22px 20px;
				}
				body.fg-open .fin-detail { transform: translate(50%, 0); }
				.fin-detail h3 { font-size: 32px; }
				.fin-detail .fd-desc { display: none; }
			}
			@media (max-width: 760px) {
				.fx-series-grid { grid-template-columns: 1fr; }
			}
			@media (max-width: 640px) {
				.fg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			}
			@media (prefers-reduced-motion: reduce) {
				.fg-tile, .fg-focus, .fg-backdrop, .fin-detail { transition: none; }
			}
		</style>
	</head>
	<body>

		<SiteHeader active="/finishes/" />

		<section class="fx-intro">
			<h1>Renuva Finishes</h1>
			<p>
				Renuva is a premium architectural film: 27 self-adhesive interior finishes that
				apply directly over existing cabinetry, doors, furniture, built-ins and wall
				panels, with no demolition, replacement or repainting. The range spans eight
				series — premium wood, painted wood, marble, metal, matte solid, high gloss,
				soft matte and fabric — and every finish carries a durable wear layer with
				scratch resistance and stain protection and is fire rated to ASTM E84 Class A.
				Select any finish below to see it applied and read its detail.
			</p>
		</section>

		<section class="fg-grid" id="fgGrid" aria-label="All Renuva finishes"></section>

		<section class="fx-series" aria-label="Renuva finish series">
			<div class="fx-series-grid">
				{series.map((s) => (
					<div class="fx-block">
						<h2>{s.name}</h2>
						<span class="fx-code">{s.code} &middot; {s.count}</span>
						<p>{s.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="fx-buy" aria-labelledby="fx-buy-heading">
			<h2 id="fx-buy-heading">Where to buy</h2>
			<p>Renuva&trade; is stocked and sold in the US by <a href={shopUrl} target="_blank" rel="noopener">Surface Supply</a>.</p>
		</section>

		<!-- focus overlay — same UI as the home-page Finish Library -->
		<div class="fg-backdrop" id="fgBackdrop"></div>
		<div class="fg-focus" id="fgFocus" aria-hidden="true"><img src="" alt="" /></div>
		<div class="fin-detail" id="fgDetail"></div>
		<button class="fin-close" id="fgClose" aria-label="Close finish detail">×</button>

		<footer>
			<div class="footer-shell">
				<div class="footer-top">
					<div class="footer-brand">
						<Image class="footer-logo" src={footerLogo} alt="Renuva logo" width={200} />
						<p class="footer-tagline">Transform existing surfaces. Renew beautifully.</p>
					</div>
				</div>
				<div class="footer-bottom">
					<nav class="footer-nav">
						<a href="/">Home</a>
						<a href="/about/">About Us</a>
						<a href="/distributor/">Distributors</a>
						<a href="/finishes/">Finishes</a>
						<a href="/visualizer/">Visualizer</a>
						<a href="/gallery/">Gallery</a>
						<a href="/contact/">Contact</a>
					</nav>
					<p class="footer-copy">&copy; 2026 Renuva Architectural Surfaces. All rights reserved.</p>
				</div>
				<nav class="footer-family" aria-label="Where to buy Renuva">
					<a href="https://surfacesupply.com/collections/renuva-architectural-film" title="Shop Renuva architectural film at Surface Supply, the US distributor" target="_blank" rel="noopener">Buy Renuva in the US</a>
					<a href="https://surfacesupply.com" title="Surface Supply, architectural film distributor" target="_blank" rel="noopener">Surface Supply</a>
				</nav>
			</div>
		</footer>

		<script is:inline src="/scripts/renuva-finish-media.js"></script>
		<script is:inline src="/scripts/renuva-finishes-grid.js"></script>
	</body>
</html>
