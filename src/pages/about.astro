---
import SiteHeader from '../components/SiteHeader.astro';
import Seo from '../components/Seo.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<Seo
			title="About Us - Renuva"
			description="Renuva is a premium architectural film brand: 27 self-adhesive interior finishes that apply over existing cabinetry, doors and furniture. Renewal without demolition or replacement, stocked in the US by Surface Supply."
		/>
		<style>
			:root {
				--very-dark-brown: #262D26;
				--dark-brown: #5E635D;
				--brown: #8D7C6E;
				--light-brown: #ADB69F;
				--cream: #F5F4EF;
				--white: #FFFFFF;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: "Inter", "Segoe UI", sans-serif;
				background: linear-gradient(180deg, #ffffff, var(--cream));
				color: var(--very-dark-brown);
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			/* Renuva brand pattern, whisper-light, sides only: masked away from
			   the center so the content column stays clean */
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -1;
				background: url("/assets/images/pattern-design.png") center/560px repeat;
				opacity: 0.09;
				pointer-events: none;
				/* clear zone anchored to the 860px content column (plus breathing
				   room) so the pattern never runs under the text or hairlines */
				-webkit-mask-image: linear-gradient(to right, black 0%, black 7%, transparent calc(50% - 500px), transparent calc(50% + 500px), black 93%, black 100%);
				mask-image: linear-gradient(to right, black 0%, black 7%, transparent calc(50% - 500px), transparent calc(50% + 500px), black 93%, black 100%);
			}

			html, body {
				overflow-x: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			main {
				width: 100%;
				max-width: 860px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem 4.5rem;
				flex: 1;
			}

			.hero {
				text-align: center;
				margin-bottom: 2.6rem;
			}

			h1 {
				/* experiment: Cormorant, the same face as the landing's
				   "Renew. Don't replace." headline */
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: clamp(1.9rem, 4.2vw, 3.1rem);
				line-height: 1.02;
				letter-spacing: 0.005em;
				color: #8C7766; /* landing hero taupe */
				margin-bottom: 0.7rem;
			}

			.hero p {
				max-width: 58ch;
				margin: 0 auto;
				color: var(--dark-brown);
				line-height: 1.7;
			}

			.about-photo {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				object-position: 50% 55%;
				border-radius: 14px;
				display: block;
				margin-bottom: 2.6rem;
			}

			.about-photo-lower {
				margin-top: 2.6rem;
				margin-bottom: 0;
				object-position: 50% 50%;
			}

			/* ── flat sections with hairlines ── */
			.block {
				padding: 1.8rem 0;
				border-top: 1px solid rgba(141, 124, 110, 0.2);
				text-align: center;
			}

			.block p {
				margin-left: auto;
				margin-right: auto;
			}

			.block:last-of-type {
				border-bottom: 1px solid rgba(141, 124, 110, 0.2);
			}

			.block-label {
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: #8C7766;
				margin-bottom: 0.7rem;
			}

			.block p {
				color: var(--dark-brown);
				line-height: 1.8;
				max-width: 68ch;
			}

			/* ── facts ── */
			.facts {
				list-style: none;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1px;
				background: rgba(141, 124, 110, 0.2);
				border: 1px solid rgba(141, 124, 110, 0.2);
				border-radius: 14px;
				overflow: hidden;
				margin: 0 0 2.6rem;
			}
			.facts li {
				background: #fff;
				padding: 1.3rem 1rem 1.2rem;
				text-align: center;
			}
			.facts b {
				display: block;
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: 2rem;
				line-height: 1;
				color: #8C7766;
			}
			.facts span {
				display: block;
				margin-top: 0.45rem;
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--brown);
			}

			/* ── photo strip ── */
			.strip {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 12px;
				margin: 2.6rem 0;
			}
			.strip figure { margin: 0; }
			.strip img {
				width: 100%;
				aspect-ratio: 4 / 5;
				object-fit: cover;
				border-radius: 12px;
				display: block;
			}
			.strip figcaption {
				margin-top: 0.55rem;
				font-size: 0.74rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--brown);
				text-align: center;
			}

			/* ── values ── */
			.values {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem 2.2rem;
				padding: 2.2rem 0;
				border-top: 1px solid rgba(141, 124, 110, 0.2);
			}
			.values h2 {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: 1.5rem;
				line-height: 1.1;
				color: #8C7766;
				margin-bottom: 0.55rem;
			}
			.values p {
				color: var(--dark-brown);
				line-height: 1.75;
				font-size: 0.95rem;
			}

			/* ── fire rating ── */
			.safety {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
				gap: 2.2rem;
				align-items: center;
				padding: 2.2rem 0;
				border-top: 1px solid rgba(141, 124, 110, 0.2);
				border-bottom: 1px solid rgba(141, 124, 110, 0.2);
			}
			.safety-copy h2 {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: clamp(1.5rem, 3vw, 2rem);
				line-height: 1.1;
				color: var(--very-dark-brown);
				margin-bottom: 0.7rem;
			}
			.safety-copy p {
				color: var(--dark-brown);
				line-height: 1.75;
				font-size: 0.95rem;
			}
			.safety-copy a {
				color: #7A6657;
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.safety-card {
				background: #fff;
				border: 1px solid rgba(141, 124, 110, 0.2);
				border-radius: 14px;
				padding: 1.4rem 1.5rem;
			}
			.safety-card dl {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 0.55rem 1rem;
				margin: 0;
			}
			.safety-card dt {
				font-size: 0.78rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--brown);
			}
			.safety-card dd {
				margin: 0;
				font-weight: 600;
				text-align: right;
				color: var(--very-dark-brown);
				font-size: 0.92rem;
			}
			.safety-card dd.big {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: 1.5rem;
				line-height: 1;
				color: #8C7766;
			}

			/* ── quote ── */
			.quote {
				text-align: center;
				padding: 3.4rem 0 3rem;
			}

			.quote blockquote {
				font-family: "Cormorant", Georgia, serif;
				font-style: italic;
				font-weight: 500;
				font-size: clamp(1.7rem, 3.8vw, 2.5rem);
				color: var(--very-dark-brown);
				line-height: 1.25;
			}

			.quote span {
				display: block;
				margin-top: 0.9rem;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--brown);
			}

			/* ── CTA ── */
			.cta {
				text-align: center;
			}

			.cta p {
				color: var(--dark-brown);
				line-height: 1.7;
				max-width: 52ch;
				margin: 0 auto 1.1rem;
			}

			.btn-3d {
				display: inline-block;
				border: none;
				cursor: pointer;
				text-decoration: none;
				text-align: center;
				color: #fff;
				background: linear-gradient(to bottom, #99836F, #8C7766);
				font: 600 0.85rem "Inter", sans-serif;
				padding: 0.7rem 1.4rem;
				border-radius: 8px;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 0 #66554A, 0 5px 12px rgba(140, 119, 102, 0.3);
				transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
			}

			.btn-3d:hover {
				background: linear-gradient(to bottom, #8C7766, #7A6657);
				transform: translateY(-1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 3px 0 #66554A, 0 7px 16px rgba(140, 119, 102, 0.35);
			}

			.btn-3d:active {
				transform: translateY(1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 1px 0 #66554A, 0 3px 8px rgba(140, 119, 102, 0.25);
			}

			/* ── footer ── */
			footer {
				background: #554B43;
				color: var(--white);
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}

			footer::before {
				content: '';
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.2), transparent 70%);
				pointer-events: none;
			}

			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}

			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.footer-logo {
				height: 44px;
				width: auto;
				display: block;
			}

			.footer-tagline {
				font-family: 'Inter', sans-serif;
				font-size: 0.9rem;
				font-weight: 300;
				color: rgba(255, 255, 255, 0.78);
			}

			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}

			.footer-nav {
				display: flex;
				gap: 1.2rem;
				flex-wrap: wrap;
			}

			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-size: 0.84rem;
				transition: color 0.3s ease;
			}

			.footer-nav a:hover { color: #fff; }

			.footer-copy {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.48);
			}
			.footer-family {
				margin-top: 0.9rem;
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				text-align: center;
			}
			.footer-family a {
				color: rgba(255, 255, 255, 0.5);
				text-decoration: none;
				font-size: 0.76rem;
				font-weight: 400;
				transition: color 0.3s;
			}
			.footer-family a:hover { color: #fff; }

			@media (max-width: 768px) {
				main { padding: 2.4rem 1rem 3.5rem; }
				.about-photo { aspect-ratio: 16 / 10; }
				.facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				.facts li:last-child { grid-column: span 2; }
				.facts b { font-size: 1.55rem; }
				.facts span { font-size: 0.64rem; letter-spacing: 0.12em; }
				.strip { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
				.strip figcaption { font-size: 0.62rem; }
				.values { grid-template-columns: 1fr; gap: 1.4rem; }
				.safety { grid-template-columns: 1fr; gap: 1.4rem; }
				.footer-brand { justify-content: center; }
				.footer-bottom { justify-content: center; text-align: center; }
			}
		</style>
	</head>
	<body>
		<SiteHeader active="/about/" />

		<main>
			<section class="hero">
				<h1>About Renuva</h1>
				<p>
					Renuva was created with the belief that renewal should feel effortless,
					thoughtful, and beautifully refined. A premium architectural film, edited
					down to the finishes that make a space feel new.
				</p>
			</section>

			<img
				class="about-photo"
				src="/assets/gallery/12.jpg"
				alt="Charcoal cabinetry and marble-look surfaces renewed with Renuva architectural film"
			/>

			<section class="block" aria-label="Our story">
				<p class="block-label">Our Story</p>
				<p>
					Renuva is a premium architectural film brand from Renuva Architectural
					Surfaces, dedicated to transforming spaces through intelligent renewal.
					Our self-adhesive films apply directly over existing cabinetry, doors,
					furniture, built-ins and wall panels, a refined alternative to replacement
					that reduces downtime and delivers beautiful results. The range is a
					curated 27 finishes across eight series, from natural woods and painted
					timber to marble, metal, matte, gloss and fabric, stocked in the United
					States and shipped by Surface Supply.
				</p>
			</section>

			<ul class="facts" aria-label="Renuva at a glance">
				<li><b>27</b><span>finishes</span></li>
				<li><b>8</b><span>series</span></li>
				<li><b>48 in</b><span>roll width</span></li>
				<li><b>5 yr</b><span>interior warranty</span></li>
				<li><b>Water-based</b><span>adhesive</span></li>
				<li><b>US stock</b><span>ships in 1 to 3 days</span></li>
			</ul>

			<section class="values" aria-label="What we stand for">
				<div>
					<h2>Edited, not endless</h2>
					<p>Twenty-seven finishes chosen to work together, so every combination in the swatch book belongs in the same room.</p>
				</div>
				<div>
					<h2>Built for daily life</h2>
					<p>A scratch- and abrasion-resistant wear layer that resists household stains and wipes clean with a damp cloth.</p>
				</div>
				<div>
					<h2>Renew, don't replace</h2>
					<p>Dry application with a squeegee over the surfaces you already have. Less waste, less noise, and a kitchen back in use the same week.</p>
				</div>
			</section>

			<div class="strip">
				<figure>
					<img src="/assets/gallery/11.jpg" alt="Pale oak fronts and a white counter renewed with Renuva" loading="lazy" />
					<figcaption>Premium Wood</figcaption>
				</figure>
				<figure>
					<img src="/assets/gallery/9.jpg" alt="Charcoal matte drawer fronts renewed with Renuva" loading="lazy" />
					<figcaption>Matte Solid</figcaption>
				</figure>
				<figure>
					<img src="/assets/gallery/3.jpg" alt="Oak kitchen with island renewed with Renuva" loading="lazy" />
					<figcaption>Renewed in place</figcaption>
				</figure>
			</div>

			<section class="block" aria-label="Our mission">
				<p class="block-label">Our Mission</p>
				<p>
					To redefine the way spaces are renewed. We transform existing surfaces
					with minimal disruption while holding the highest standards of quality
					and design.
				</p>
			</section>

			<section class="block" aria-label="Our vision">
				<p class="block-label">Our Vision</p>
				<p>
					A future where renewal is intentional, sustainable, and beautifully
					uncomplicated. Calm, efficient, design-driven transformation that
					respects time, materials, and the people who experience it.
				</p>
			</section>

			<section class="safety" aria-label="Fire rating">
				<div class="safety-copy">
					<h2>Fire rated to ASTM E84</h2>
					<p>
						Renuva is tested to ASTM E84, the surface-burning test used to accept
						interior finishes in the United States, by an ISO/IEC 17025:2017
						accredited laboratory. The result is Class A across the range; the
						High Gloss Solid series is Class B. ASTM E84 rates surface-burning
						characteristics only and does not make a material noncombustible.
						Each finish shows its rating in the <a href="/finishes/">finish library</a>.
					</p>
				</div>
				<div class="safety-card">
					<dl>
						<dt>Standard</dt><dd>ASTM E84</dd>
						<dt>Classification</dt><dd class="big">Class A</dd>
						<dt>Flame spread index</dt><dd>25</dd>
						<dt>Smoke developed index</dt><dd>15</dd>
						<dt>High Gloss Solid series</dt><dd>Class B</dd>
					</dl>
				</div>
			</section>

			<img
				class="about-photo about-photo-lower"
				src="/assets/gallery/14.jpg"
				alt="Light oak kitchen renewed with Renuva architectural film"
			/>

			<section class="quote">
				<blockquote>&ldquo;A smarter way to renew.&rdquo;</blockquote>
				<span>The Renuva Philosophy</span>
			</section>

			<section class="cta">
				<p>Have a project in mind, or want to learn more about Renuva?</p>
				<a href="/contact/" class="btn-3d">Get In Touch</a>
			</section>
		</main>

		<footer>
			<div class="footer-shell">
				<div class="footer-top">
					<div class="footer-brand">
						<img class="footer-logo" src="/assets/images/LOGO_Colorful_Colorful_Colorful_White.png" alt="Renuva logo" />
						<p class="footer-tagline">Transform existing surfaces. Renew beautifully.</p>
					</div>
				</div>
				<div class="footer-bottom">
					<nav class="footer-nav">
						<a href="/">Home</a>
						<a href="/about/">About Us</a>
						<a href="/distributor/">Distributors</a>
						<a href="/finishes/">Finishes</a>
						<a href="/visualizer/">Visualizer</a>
						<a href="/gallery/">Gallery</a>
						<a href="/contact/">Contact</a>
					</nav>
					<p class="footer-copy">&copy; 2026 Renuva Architectural Surfaces. All rights reserved.</p>
				</div>
				<nav class="footer-family" aria-label="Where to buy Renuva">
					<a href="https://surfacesupply.com/collections/renuva-architectural-film" title="Shop Renuva architectural film at Surface Supply, the US distributor" target="_blank" rel="noopener">Buy Renuva in the US</a>
					<a href="https://surfacesupply.com" title="Surface Supply, architectural film distributor" target="_blank" rel="noopener">Surface Supply</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
