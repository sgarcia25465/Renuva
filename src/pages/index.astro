---
import { Image } from 'astro:assets';
import renuvamain from '../assets/images/RENUVAMAIN.png';
import footerLogo from '../assets/images/LOGO_Colorful_Colorful_Colorful_White.png';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant:wght@300;400;500&family=Marcellus&family=Italiana&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Renuva — Renew. Don't replace.</title>
		<style is:global>
			:root {
				--paper: #F5F2EC;
				--taupe: #8C7766;
				--taupe-deep: #7A6657;
				--ink: #4B4540;
				--muted: #756E64;
				--card: #FDFCFA;
				--headline-font: 'Marcellus', serif;
				--headline-weight: 400;
				--headline-tracking: 0.005em;
			}
			* { margin: 0; padding: 0; box-sizing: border-box; }
			html, body { overflow-x: clip; }
			body {
				background: var(--paper);
				font-family: 'Hanken Grotesk', sans-serif;
				color: var(--ink);
			}

			/* ============ HERO ============ */
			.hero {
				min-height: 100vh;
				background: var(--paper);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 36px clamp(24px, 5vw, 80px);
			}
			.logo { display: block; }
			.logo img { height: 48px; width: auto; display: block; }
			.nav-right { display: flex; align-items: center; gap: 40px; }
			.nav-links { display: flex; gap: 40px; }
			.nav-links a {
				font-family: 'Instrument Serif', serif;
				font-size: 21px;
				color: #5E574E;
				text-decoration: none;
			}
			.nav-links a:hover { color: var(--taupe); }
			.contact-btn {
				font-size: 15px;
				font-weight: 600;
				color: #fff;
				background: var(--taupe);
				text-decoration: none;
				padding: 14px 28px;
				border-radius: 8px;
				transition: background 0.2s ease;
			}
			.contact-btn:hover { background: var(--taupe-deep); }

			.hero-grid {
				flex: 1;
				display: flex;
				align-items: center;
				gap: clamp(16px, 3vw, 56px);
				padding-left: clamp(24px, 6vw, 96px);
				min-height: 0;
			}
			.hero-copy {
				flex: 0 0 min(500px, 40%);
				text-align: center;
			}
			.eyebrow {
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.28em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.hero-copy h1 {
				margin-top: 22px;
				font-family: var(--headline-font);
				font-weight: var(--headline-weight);
				color: var(--taupe);
				font-size: clamp(34.5px, 9.66vw, 55.2px);
				line-height: 1.1;
				letter-spacing: var(--headline-tracking);
				text-wrap: pretty;
			}
			.cta-btn {
				display: inline-block;
				margin-top: 36px;
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: #fff;
				background: var(--taupe);
				text-decoration: none;
				padding: 17px 34px;
				border-radius: 8px;
				transition: background 0.2s ease, transform 0.2s ease;
			}
			.cta-btn:hover { background: var(--taupe-deep); transform: translateY(-1px); }

			.hero-copy > * { animation: riseIn 1s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
			.hero-copy h1 { animation: none; }
			.hero-copy .cta-btn { animation-delay: 2.5s; }
			@keyframes riseIn { from { opacity: 0; transform: translateY(24px); } }
			@media (prefers-reduced-motion: reduce) { .hero-copy > * { animation: none; } }

			/* Typewriter headline — characters reveal in their final (centered) positions */
			.typer { display: inline-block; visibility: hidden; }
			.typer .ch { visibility: hidden; }
			.typer .ch.on, .typer .caret { visibility: visible; }
			.caret {
				display: inline-block;
				width: 0.045em;
				height: 0.74em;
				background: currentColor;
				margin-left: 0.06em;
				vertical-align: -0.02em;
				animation: caretBlink 0.9s steps(1, end) infinite;
			}
			.caret.done { animation: none; opacity: 0; }
			@keyframes caretBlink { 50% { opacity: 0; } }
			@media (prefers-reduced-motion: reduce) { .caret { display: none; } }

			.hero-art {
				flex: 1;
				min-width: 0;
				align-self: flex-end;
				margin-right: -3vw;
				padding-bottom: 4vh;
			}
			.hero-art canvas { width: 100%; height: auto; max-height: 82vh; display: block; margin-left: auto; }

			/* ============ SECTION 2 PANEL ============ */
			.panel {
				position: relative;
				background: var(--paper);
			}
			.resurface {
				min-height: 100vh;
				display: grid;
				grid-template-columns: minmax(260px, 340px) 1fr;
				gap: clamp(24px, 4vw, 64px);
				align-items: center;
				padding: clamp(48px, 8vh, 96px) clamp(24px, 5vw, 84px);
			}
			.compare-col {
				display: flex;
				flex-direction: column;
				gap: 22px;
				min-width: 0;
			}
			.compare-stack {
				width: 100%;
				aspect-ratio: 1024 / 683;
				display: flex;
				flex-direction: column;
				border-radius: 14px;
				overflow: hidden;
				box-shadow: 0 24px 70px rgba(75,69,64,0.14);
			}
			.cmp {
				position: relative;
				width: 100%;
				height: 50%;
				overflow: hidden;
				touch-action: none;
				cursor: ew-resize;
				background: var(--paper);
				user-select: none;
			}
			.cmp + .cmp { border-top: 1px solid rgba(75,69,64,0.18); }
			.cmp img {
				position: absolute;
				left: 0;
				width: 100%;
				height: auto;
				display: block;
				pointer-events: none;
				-webkit-user-drag: none;
			}
			.cmp.top img { top: 0; }
			.cmp.bot img { top: -100%; }
			.cmp-photo { position: absolute; inset: 0; }
			.cmp-handle {
				position: absolute;
				top: 0; bottom: 0;
				left: 50%;
				width: 0;
				z-index: 2;
			}
			.cmp-handle::before {
				content: "";
				position: absolute;
				top: 0; bottom: 0;
				left: -1px;
				width: 2px;
				background: #fff;
				box-shadow: 0 0 0 1px rgba(75,69,64,0.22);
			}
			.cmp-grip {
				position: absolute;
				top: 50%; left: 0;
				transform: translate(-50%, -50%);
				width: 44px; height: 44px;
				border-radius: 50%;
				background: var(--taupe);
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 3px;
				font-size: 15px;
				line-height: 1;
				box-shadow: 0 6px 18px rgba(75,69,64,0.35);
			}
			.cmp-tag {
				position: absolute;
				top: 12px;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				padding: 6px 12px;
				border-radius: 6px;
				z-index: 1;
				pointer-events: none;
			}
			.cmp-tag.l { left: 12px; background: rgba(253,252,250,0.85); color: #756E64; }
			.cmp-tag.r { right: 12px; background: rgba(75,69,64,0.65); color: #fff; }

			/* sleek typographic info block (no card) */
			.info-block { align-self: center; max-width: 460px; }
			.info-title {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				color: var(--taupe);
				font-size: clamp(46px, 4.6vw, 78px);
				line-height: 1.0;
				letter-spacing: -0.01em;
			}
			.info-title .typer2 { position: relative; display: inline-block; white-space: pre-line; }
			.info-title .typer-ghost { visibility: hidden; }
			.info-title .typer-live { position: absolute; inset: 0; }
			.info-title .caret {
				display: inline-block;
				width: 0.045em; height: 0.78em;
				background: currentColor;
				margin-left: 0.04em;
				vertical-align: -0.04em;
				animation: caretBlink 0.9s steps(1, end) infinite;
			}
			.info-title .caret.done { animation: none; opacity: 0; }

			.info-sub {
				margin-top: 22px;
				color: var(--muted);
				font-size: clamp(15px, 1.25vw, 18px);
				letter-spacing: 0.01em;
			}

			.cat-list {
				margin-top: 40px;
				list-style: none;
				border-top: 1px solid rgba(75,69,64,0.16);
			}
			.cat-list li {
				display: flex;
				align-items: baseline;
				gap: 18px;
				padding: 17px 2px;
				border-bottom: 1px solid rgba(75,69,64,0.16);
				overflow: hidden;
			}
			.cat-list .cat-idx {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #B7AC9B;
				min-width: 26px;
			}
			.cat-list .cat-name {
				font-size: clamp(16px, 1.5vw, 20px);
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--ink);
			}
			/* staggered reveal */
			.reveal-up { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.2,0.7,0.2,1), transform 0.7s cubic-bezier(0.2,0.7,0.2,1); }
			.info-block.reveal .reveal-up { opacity: 1; transform: none; }
			.info-block.reveal .info-sub { transition-delay: 0.05s; }
			.info-block.reveal .cat-list li:nth-child(1) .cat-line { transition-delay: 0.18s; }
			.info-block.reveal .cat-list li:nth-child(2) .cat-line { transition-delay: 0.30s; }
			.info-block.reveal .cat-list li:nth-child(3) .cat-line { transition-delay: 0.42s; }
			.cat-line { display: flex; align-items: baseline; gap: 18px; width: 100%; transform: translateY(110%); transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1); }
			.info-block.reveal .cat-line { transform: none; }
			@media (prefers-reduced-motion: reduce) {
				.reveal-up, .cat-line { transition: none; opacity: 1; transform: none; }
			}

			/* ============ SECTION: SWATCH BOOK FAN DECK ============ */
			.fandeck {
				min-height: 100vh;
				background: var(--paper);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: clamp(48px, 7vh, 90px) 16px clamp(32px, 5vh, 64px);
				overflow: hidden;
			}
			.fd-head { text-align: center; }
			.fd-title {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(34px, 3.6vw, 54px);
				line-height: 1.05;
				color: var(--taupe);
			}
			.deck {
				--dk: min(114vmin, 98vw, 1300px);
				position: relative;
				width: var(--dk);
				height: var(--dk);
				margin-top: calc(clamp(4px, 1.2vh, 16px) - var(--dk) * 0.015);
			}

			/* one physical swatch strip */
			.swatch {
				position: absolute;
				left: 50%;
				top: 50%;
				width: calc(var(--dk) * 0.47);
				height: calc(var(--dk) * 0.125);
				border: 0;
				padding: 0;
				border-radius: calc(var(--dk) * 0.013);
				background-size: cover;
				background-position: center;
				cursor: pointer;
				transform-origin: calc(var(--dk) * 0.0625) 50%;
				transform: translate(calc(var(--dk) * -0.0625), -50%) rotate(0deg);
				transition: transform 1.15s cubic-bezier(0.22, 0.8, 0.2, 1);
				transition-delay: var(--d);
				box-shadow: 0 calc(var(--dk) * 0.008) calc(var(--dk) * 0.03) rgba(75, 69, 64, 0.22),
					inset 0 0 0 1px rgba(75, 69, 64, 0.07);
				-webkit-tap-highlight-color: transparent;
			}
			.deck.open .swatch {
				transform: translate(calc(var(--dk) * -0.0625), -50%) rotate(var(--a)) translateX(var(--out, 0px));
			}
			.deck.settled .swatch {
				transition: transform 0.38s cubic-bezier(0.22, 0.8, 0.2, 1), z-index 0s linear 0.38s;
			}
			.deck.settled .swatch:hover,
			.deck.settled .swatch:focus-visible {
				--out: calc(var(--dk) * 0.075);
				z-index: 60 !important;
				transition: transform 0.38s cubic-bezier(0.22, 0.8, 0.2, 1), z-index 0s linear 0s;
				box-shadow: 0 calc(var(--dk) * 0.016) calc(var(--dk) * 0.05) rgba(75, 69, 64, 0.32),
					inset 0 0 0 1px rgba(75, 69, 64, 0.07);
			}
			.swatch:focus-visible { outline: 2px solid var(--taupe); outline-offset: 3px; }

			.sw-label {
				position: absolute;
				top: 50%;
				right: calc(var(--dk) * 0.022);
				transform: translateY(-50%);
				text-align: right;
				color: #55504A;
				pointer-events: none;
			}
			.swatch.is-dark .sw-label { color: rgba(255, 255, 255, 0.93); }
			.sw-code {
				display: block;
				font-size: calc(var(--dk) * 0.0155);
				font-weight: 600;
				letter-spacing: 0.09em;
				padding-bottom: calc(var(--dk) * 0.003);
				border-bottom: 1px solid currentColor;
			}
			.sw-brand {
				display: block;
				margin-top: calc(var(--dk) * 0.0035);
				font-size: calc(var(--dk) * 0.0095);
				font-weight: 600;
				letter-spacing: 0.28em;
				opacity: 0.85;
			}

			/* cover card — clean digital rebuild of the deck cover */
			.deck-cover {
				position: absolute;
				left: 50%;
				top: 50%;
				width: calc(var(--dk) * 0.52);
				height: calc(var(--dk) * 0.27);
				transform: translate(calc(var(--dk) * -0.055), calc(var(--dk) * -0.076));
				z-index: 40;
				border-radius: calc(var(--dk) * 0.016);
				background:
					repeating-linear-gradient(45deg, rgba(190, 176, 152, 0.055) 0 3px, transparent 3px 9px),
					repeating-linear-gradient(-45deg, rgba(190, 176, 152, 0.055) 0 3px, transparent 3px 9px),
					linear-gradient(160deg, #F7F3E9, #EFE9DB);
				box-shadow: 0 calc(var(--dk) * 0.014) calc(var(--dk) * 0.045) rgba(75, 69, 64, 0.30),
					inset 0 0 0 1px rgba(75, 69, 64, 0.08);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				pointer-events: none;
			}
			.dc-logo {
				font-family: 'Italiana', serif;
				font-size: calc(var(--dk) * 0.052);
				letter-spacing: 0.22em;
				text-indent: 0.22em;
				line-height: 1;
				background: linear-gradient(100deg, #A98B54 8%, #D9C08D 38%, #C0A263 60%, #E4CF9E 82%, #A98B54 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.dc-tag {
				margin-top: calc(var(--dk) * 0.010);
				font-size: calc(var(--dk) * 0.0125);
				letter-spacing: 0.34em;
				text-indent: 0.34em;
				color: #B49A6C;
			}
			.dc-foot {
				position: absolute;
				bottom: calc(var(--dk) * 0.020);
				left: 0; right: 0;
				text-align: center;
				font-size: calc(var(--dk) * 0.0115);
				letter-spacing: 0.22em;
				text-indent: 0.22em;
				color: #9A8F7E;
			}
			.dc-snap {
				position: absolute;
				left: calc(var(--dk) * 0.055);
				top: calc(var(--dk) * 0.076);
				width: calc(var(--dk) * 0.034);
				height: calc(var(--dk) * 0.034);
				transform: translate(-50%, -50%);
				border-radius: 50%;
				background: radial-gradient(circle at 34% 30%, #FBFBF9, #C9C6C0 45%, #8F8B84 78%, #6E6A64);
				box-shadow: 0 1px 4px rgba(75, 69, 64, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.5);
			}

			/* ---- full view modal ---- */
			.fdm[hidden] { display: none; }
			.fdm {
				position: fixed;
				inset: 0;
				z-index: 6000;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: clamp(12px, 3vw, 40px);
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			.fdm.on { opacity: 1; }
			.fdm-back {
				position: absolute;
				inset: 0;
				background: rgba(62, 56, 51, 0.52);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
			}
			.fdm-card {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
				width: min(1240px, 96vw);
				height: min(720px, 88vh);
				background: var(--card);
				border-radius: 22px;
				overflow: hidden;
				box-shadow: 0 40px 120px rgba(30, 26, 22, 0.45);
				transform: translateY(14px) scale(0.97);
				transition: transform 0.38s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.fdm.on .fdm-card { transform: none; }
			.fdm-img {
				position: relative;
				min-height: 100%;
				background: #E8E2D8;
			}
			.fdm-img img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.fdm-info {
				padding: clamp(30px, 4vw, 58px);
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-height: 0;
				overflow-y: auto;
			}
			.fdm-meta {
				display: flex;
				align-items: baseline;
				gap: 14px;
				font-size: 11.5px;
				font-weight: 600;
				letter-spacing: 0.24em;
				text-transform: uppercase;
			}
			.fdm-series { color: #A2937F; }
			.fdm-code { color: #756E64; }
			.fdm-name {
				margin-top: 16px;
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(38px, 4.2vw, 64px);
				line-height: 1.0;
				letter-spacing: -0.01em;
				color: var(--taupe);
			}
			.fdm-desc {
				margin-top: 22px;
				max-width: 42ch;
				font-size: 16px;
				font-weight: 400;
				line-height: 1.7;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fdm-specs {
				margin-top: clamp(22px, 3.5vh, 36px);
				padding-top: 22px;
				border-top: 1px solid rgba(75, 69, 64, 0.13);
				display: flex;
				gap: clamp(24px, 3vw, 44px);
			}
			.fdm-specs > div { display: flex; flex-direction: column; gap: 7px; }
			.fdm-specs .fs-l {
				font-size: 10.5px;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: #A99E8D;
			}
			.fdm-specs .fs-v { font-size: 14.5px; font-weight: 550; color: var(--ink); }
			.fdm-foot {
				margin-top: clamp(28px, 5vh, 46px);
				padding-top: 0;
				display: flex;
				align-items: center;
				gap: 14px;
			}
			.fdm-link {
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 0.1em;
				color: #fff;
				background: var(--taupe);
				text-decoration: none;
				padding: 13px 22px;
				border-radius: 8px;
				transition: background 0.2s ease;
				white-space: nowrap;
			}
			.fdm-link:hover { background: var(--taupe-deep); }
			.fdm-nav {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.fdm-count { font-size: 12px; letter-spacing: 0.1em; color: #998F82; }
			.fdm-prev, .fdm-next, .fdm-close {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				border: 1px solid rgba(75, 69, 64, 0.22);
				background: rgba(253, 252, 250, 0.92);
				color: #5E574E;
				font-size: 17px;
				line-height: 1;
				cursor: pointer;
				transition: background 0.2s ease;
			}
			.fdm-prev:hover, .fdm-next:hover, .fdm-close:hover { background: #fff; }
			.fdm-close {
				position: absolute;
				top: 14px;
				right: 14px;
				z-index: 2;
				box-shadow: 0 4px 14px rgba(30, 26, 22, 0.18);
			}

			@media (max-width: 760px) {
				.fandeck { min-height: 0; }
				.deck { --dk: min(100vmin, 600px); }
				.fdm { padding: 10px; align-items: flex-end; }
				.fdm-card {
					grid-template-columns: 1fr;
					max-height: 92vh;
					width: 100%;
				}
				.fdm-img { aspect-ratio: 16 / 10; min-height: 0; }
				.fdm-foot { flex-wrap: wrap; }
			}
			@media (prefers-reduced-motion: reduce) {
				.swatch, .fdm, .fdm-card { transition: none; }
			}

			/* ============ SECTION: FINISH LIBRARY — diagonal card stack (light) ============ */
			.finishes {
				position: relative;
				background: var(--paper);
				color: var(--ink);
				margin-top: 25vh;
				margin-bottom: 22vh;
			}

			.fin-stage {
				position: relative;
				height: 100vh;
				overflow: hidden;
				background: var(--paper);
			}
			/* melt the card stack into the paper background so the section
			   blends into the kitchen compare below instead of cutting off */
			.fin-stage::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 24vh;
				background: linear-gradient(to bottom, rgba(245, 242, 236, 0), #F5F2EC 82%);
				z-index: 2100;
				pointer-events: none;
				transition: opacity 0.4s ease;
			}
			.fin-stage.open::after,
			.fin-stage.closing::after { opacity: 0; }

			/* heading — anchored top-LEFT */
			.fin-head {
				position: absolute;
				top: clamp(40px, 7vh, 86px);
				left: clamp(28px, 5vw, 84px);
				z-index: 3000;
				pointer-events: none;
				max-width: 60vw;
				transition: opacity 0.35s ease;
			}
			.fin-eyebrow {
				font-size: clamp(34px, 3.6vw, 54px);
				font-family: 'Cormorant', serif;
				font-weight: 500;
				letter-spacing: 0.005em;
				color: var(--taupe);
				line-height: 1.05;
			}

			/* opaque backdrop revealed when a finish is opened */
			.fin-backdrop {
				position: absolute;
				inset: 0;
				background: #EFEAE1;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s ease;
				z-index: 1500;
			}

			.fin-cards {
				position: absolute;
				inset: 0;
				perspective: 1700px;
				perspective-origin: 50% 50%;
				z-index: 1600;
				touch-action: pan-y;
			}

			.fcard {
				position: absolute;
				left: 50%;
				top: 50%;
				width: min(27vw, 400px);
				aspect-ratio: 4 / 5;
				border-radius: 7px;
				overflow: hidden;
				background: #E8E2D8;
				cursor: pointer;
				box-shadow: 0 30px 80px rgba(75, 69, 64, 0.30);
				will-change: transform, opacity;
			}
			.fcard img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				-webkit-user-drag: none;
				user-select: none;
			}
			.fcard-label {
				position: absolute;
				left: 14px;
				bottom: 14px;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: #5E574E;
				background: rgba(253, 252, 250, 0.88);
				backdrop-filter: blur(6px);
				padding: 7px 12px;
				border-radius: 6px;
				pointer-events: none;
				white-space: nowrap;
			}

			/* open / focus states */
			.fin-stage.open .fcard,
			.fin-stage.closing .fcard { transition: transform 0.8s cubic-bezier(0.22, 0.8, 0.2, 1), opacity 0.5s ease; }
			.fcard.focus { box-shadow: 0 50px 130px rgba(75, 69, 64, 0.42); }

			/* detail panel */
			.fin-detail {
				position: absolute;
				top: 50%;
				right: clamp(28px, 7vw, 130px);
				width: min(34vw, 400px);
				transform: translateY(-46%);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
				z-index: 2700;
			}
			.fin-stage.open .fin-detail {
				opacity: 1;
				transform: translateY(-50%);
				transition-delay: 0.35s;
				pointer-events: auto;
			}
			.fin-detail .fd-series {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.fin-detail h3 {
				margin-top: 10px;
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(40px, 3.6vw, 58px);
				line-height: 1.02;
				color: var(--taupe);
			}
			.fin-detail .fd-desc {
				margin-top: 16px;
				font-size: 15px;
				line-height: 1.6;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fin-detail .fd-specs {
				margin-top: 24px;
				border-top: 1px solid rgba(75, 69, 64, 0.16);
			}
			.fin-detail .fd-specs > div {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				padding: 11px 0;
				border-bottom: 1px solid rgba(75, 69, 64, 0.16);
				font-size: 14px;
			}
			.fin-detail .fd-specs dt { color: #998F82; }
			.fin-detail .fd-specs dd { font-weight: 600; color: var(--ink); text-align: right; white-space: nowrap; }
			.fin-detail .fd-link {
				display: inline-block;
				margin-top: 24px;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--ink);
				text-decoration: none;
				border-bottom: 1px solid currentColor;
				padding-bottom: 3px;
			}
			.fin-detail .fd-link:hover { color: var(--taupe); }

			/* close button */
			.fin-close {
				position: absolute;
				top: 32px;
				right: 36px;
				width: 46px;
				height: 46px;
				border-radius: 50%;
				border: 1px solid rgba(75, 69, 64, 0.22);
				background: rgba(253, 252, 250, 0.9);
				color: #5E574E;
				font-size: 20px;
				line-height: 1;
				cursor: pointer;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease, background 0.3s ease;
				z-index: 3000;
			}
			.fin-stage.open .fin-close { opacity: 1; pointer-events: auto; }
			.fin-close:hover { background: #fff; }

			/* ============ FOOTER ============ */
			footer {
				background: #3E3833;
