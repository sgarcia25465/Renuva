		<script is:inline>
			/* Hero typewriter — each character is revealed in its final position so the
			   centered headline never shifts while typing. */
			(function () {
				const typer = document.getElementById('heroTyper');
				if (!typer) return;
				const full = typer.textContent.replace(/\n\s*/g, '\n').trim();
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				typer.textContent = '';
				const caret = document.createElement('span');
				caret.className = 'caret';
				caret.setAttribute('aria-hidden', 'true');
				const chars = [];
				for (const ch of full) {
					if (ch === '\n') { typer.appendChild(document.createElement('br')); continue; }
					const s = document.createElement('span');
					s.className = 'ch';
					s.textContent = ch;
					typer.appendChild(s);
					chars.push(s);
				}
				typer.appendChild(caret);
				if (reduce) {
					chars.forEach(function (c) { c.classList.add('on'); });
					caret.classList.add('done');
					return;
				}
				if (chars.length) typer.insertBefore(caret, chars[0]);
				let i = 0;
				function step() {
					if (i >= chars.length) {
						setTimeout(function () { caret.classList.add('done'); }, 1400);
						return;
					}
					const c = chars[i];
					c.classList.add('on');
					if (c.nextSibling) typer.insertBefore(caret, c.nextSibling);
					else typer.appendChild(caret);
					const t = c.textContent;
					i++;
					let d = 31 + Math.random() * 27;
					if (t === '.' || t === ',') d = 210;
					else if (t === ' ') d = 60;
					setTimeout(step, d);
				}
				setTimeout(step, 175);
			})();
		</script>

		<script is:inline src="/scripts/renuva-photo-kitchen.js"></script>
		<script is:inline src="/scripts/renuva-finishes.js"></script>
		<script is:inline>
			(function () {
				const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				/* ---- hero: continuous smooth wrap loop ---- */
				const hero = RenuvaPhotoKitchen.create(document.getElementById('heroKitchen'));
				const heroCycle = 11.52; // seconds

				function heroProgress(timeSec) {
					const t = (timeSec % heroCycle) / heroCycle;
					return 0.5 - 0.5 * Math.cos(2 * Math.PI * t); // sinusoidal: always in motion
				}

				const start = performance.now();
				function frame(now) {
					if (window.scrollY < window.innerHeight * 1.05) {
						hero.setProgress(reduced ? 1 : heroProgress((now - start) / 1000));
					}
					requestAnimationFrame(frame);
				}
				requestAnimationFrame(frame);

				/* ---- section: dual before/after sliders (top + bottom halves) ---- */
				document.querySelectorAll('.cmp').forEach(function (el) {
					const photo = el.querySelector('.cmp-photo');
					const handle = el.querySelector('.cmp-handle');
					let dragging = false;
					function set(p) {
						p = Math.max(0.03, Math.min(0.97, p));
						photo.style.clipPath = 'inset(0 0 0 ' + (p * 100).toFixed(2) + '%)'; // drawing left, photo right
						handle.style.left = (p * 100).toFixed(2) + '%';
					}
					set(0.5); // start centered
					function move(clientX) {
						const r = el.getBoundingClientRect();
						set((clientX - r.left) / r.width);
					}
					el.addEventListener('pointerdown', function (e) {
						dragging = true;
						el.setPointerCapture(e.pointerId);
						move(e.clientX);
						e.preventDefault();
					});
					el.addEventListener('pointermove', function (e) { if (dragging) move(e.clientX); });
					el.addEventListener('pointerup', function () { dragging = false; });
					el.addEventListener('pointercancel', function () { dragging = false; });
				});

				/* ---- section: entrance reveal + typed headline ---- */
				const infoBlock = document.getElementById('infoBlock');

				function typeTitle() {
					const h2 = infoBlock.querySelector('.info-title');
					const typed = h2.querySelector('.typed');
					const caret = h2.querySelector('.caret');
					const full = h2.querySelector('.typer-ghost').textContent.replace(/\n\s*/g, '\n');
					if (reduced) { typed.textContent = full; if (caret) caret.classList.add('done'); return; }
					let i = 0;
					(function step() {
						typed.textContent = full.slice(0, i);
						if (i >= full.length) { setTimeout(function () { if (caret) caret.classList.add('done'); }, 1200); return; }
						const ch = full[i]; i++;
						let d = 34 + Math.random() * 30;
						if (ch === '.' || ch === ',') d = 230;
						else if (ch === ' ' || ch === '\n') d = 70;
						setTimeout(step, d);
					})();
				}

				const io = new IntersectionObserver(function (entries) {
					entries.forEach(function (en) {
						if (!en.isIntersecting) return;
						infoBlock.classList.add('reveal');
						setTimeout(typeTitle, 220);
						io.unobserve(infoBlock);
					});
				}, { threshold: 0.35 });
				io.observe(infoBlock);
			})();
		</script>
	</body>
