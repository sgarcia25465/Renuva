---
import { Image } from 'astro:assets';
import renuvamain from '../assets/images/RENUVAMAIN.png';
import footerLogo from '../assets/images/LOGO_Colorful_Colorful_Colorful_White.png';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant:wght@300;400;500&family=Marcellus&family=Italiana&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Renuva — Renew. Don't replace.</title>
		<style is:global>
			:root {
				--paper: #F5F2EC;
				--taupe: #8C7766;
				--taupe-deep: #7A6657;
				--ink: #4B4540;
				--muted: #756E64;
				--card: #FDFCFA;
				--headline-font: 'Marcellus', serif;
				--headline-weight: 400;
				--headline-tracking: 0.005em;
			}
			* { margin: 0; padding: 0; box-sizing: border-box; }
			html, body { overflow-x: clip; }
			body {
				background: var(--paper);
				font-family: 'Hanken Grotesk', sans-serif;
				color: var(--ink);
			}

			/* ============ HERO ============ */
			.hero {
				min-height: 100vh;
				background: var(--paper);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 36px clamp(24px, 5vw, 80px);
			}
			.logo { display: block; }
			.logo img { height: 48px; width: auto; display: block; }
			.nav-right { display: flex; align-items: center; gap: 40px; }
			.nav-links { display: flex; gap: 40px; }
			.nav-links a {
				font-family: 'Instrument Serif', serif;
				font-size: 21px;
				color: #5E574E;
				text-decoration: none;
			}
			.nav-links a:hover { color: var(--taupe); }
			.contact-btn {
				font-size: 15px;
				font-weight: 600;
				color: #fff;
				background: var(--taupe);
				text-decoration: none;
				padding: 14px 28px;
				border-radius: 8px;
				transition: background 0.2s ease;
			}
			.contact-btn:hover { background: var(--taupe-deep); }

			.hero-grid {
				flex: 1;
				display: flex;
				align-items: center;
				gap: clamp(16px, 3vw, 56px);
				padding-left: clamp(24px, 6vw, 96px);
				min-height: 0;
			}
			.hero-copy {
				flex: 0 0 min(500px, 40%);
				text-align: center;
			}
			.eyebrow {
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.28em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.hero-copy h1 {
				margin-top: 22px;
				font-family: var(--headline-font);
				font-weight: var(--headline-weight);
				color: var(--taupe);
				font-size: clamp(30px, 8.4vw, 48px);
				line-height: 1.1;
				letter-spacing: var(--headline-tracking);
				text-wrap: pretty;
			}
			.cta-btn {
				display: inline-block;
				margin-top: 36px;
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: #fff;
				background: var(--taupe);
				text-decoration: none;
				padding: 17px 34px;
				border-radius: 8px;
				transition: background 0.2s ease, transform 0.2s ease;
			}
			.cta-btn:hover { background: var(--taupe-deep); transform: translateY(-1px); }

			.hero-copy > * { animation: riseIn 1s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
			.hero-copy h1 { animation: none; }
			.hero-copy .cta-btn { animation-delay: 2.5s; }
			@keyframes riseIn { from { opacity: 0; transform: translateY(24px); } }
			@media (prefers-reduced-motion: reduce) { .hero-copy > * { animation: none; } }

			/* Typewriter headline — characters reveal in their final (centered) positions */
			.typer { display: inline-block; visibility: hidden; }
			.typer .ch { visibility: hidden; }
			.typer .ch.on, .typer .caret { visibility: visible; }
			.caret {
				display: inline-block;
				width: 0.045em;
				height: 0.74em;
				background: currentColor;
				margin-left: 0.06em;
				vertical-align: -0.02em;
				animation: caretBlink 0.9s steps(1, end) infinite;
			}
			.caret.done { animation: none; opacity: 0; }
			@keyframes caretBlink { 50% { opacity: 0; } }
			@media (prefers-reduced-motion: reduce) { .caret { display: none; } }

			.hero-art {
				flex: 1;
				min-width: 0;
				align-self: flex-end;
				margin-right: -3vw;
				padding-bottom: 4vh;
			}
			.hero-art canvas { width: 100%; height: auto; max-height: 82vh; display: block; margin-left: auto; }

			/* ============ SECTION 2 PANEL ============ */
			.panel {
				position: relative;
				background: var(--paper);
			}
			.resurface {
				min-height: 100vh;
				display: grid;
				grid-template-columns: minmax(260px, 340px) 1fr;
				gap: clamp(24px, 4vw, 64px);
				align-items: center;
				padding: clamp(48px, 8vh, 96px) clamp(24px, 5vw, 84px);
			}
			.compare-col {
				display: flex;
				flex-direction: column;
				gap: 22px;
				min-width: 0;
			}
			.compare-stack {
				width: 100%;
				aspect-ratio: 1024 / 683;
				display: flex;
				flex-direction: column;
				border-radius: 14px;
				overflow: hidden;
				box-shadow: 0 24px 70px rgba(75,69,64,0.14);
			}
			.cmp {
				position: relative;
				width: 100%;
				height: 50%;
				overflow: hidden;
				touch-action: none;
				cursor: ew-resize;
				background: var(--paper);
				user-select: none;
			}
			.cmp + .cmp { border-top: 1px solid rgba(75,69,64,0.18); }
			.cmp img {
				position: absolute;
				left: 0;
				width: 100%;
				height: auto;
				display: block;
				pointer-events: none;
				-webkit-user-drag: none;
			}
			.cmp.top img { top: 0; }
			.cmp.bot img { top: -100%; }
			.cmp-photo { position: absolute; inset: 0; }
			.cmp-handle {
				position: absolute;
				top: 0; bottom: 0;
				left: 50%;
				width: 0;
				z-index: 2;
			}
			.cmp-handle::before {
				content: "";
				position: absolute;
				top: 0; bottom: 0;
				left: -1px;
				width: 2px;
				background: #fff;
				box-shadow: 0 0 0 1px rgba(75,69,64,0.22);
			}
			.cmp-grip {
				position: absolute;
				top: 50%; left: 0;
				transform: translate(-50%, -50%);
				width: 44px; height: 44px;
				border-radius: 50%;
				background: var(--taupe);
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 3px;
				font-size: 15px;
				line-height: 1;
				box-shadow: 0 6px 18px rgba(75,69,64,0.35);
			}
			.cmp-tag {
				position: absolute;
				top: 12px;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				padding: 6px 12px;
				border-radius: 6px;
				z-index: 1;
				pointer-events: none;
			}
			.cmp-tag.l { left: 12px; background: rgba(253,252,250,0.85); color: #756E64; }
			.cmp-tag.r { right: 12px; background: rgba(75,69,64,0.65); color: #fff; }

			/* sleek typographic info block (no card) */
			.info-block { align-self: center; max-width: 460px; }
			.info-title {
				font-family: 'Cormorant', serif;
				font-weight: 500;
				color: var(--taupe);
				font-size: clamp(46px, 4.6vw, 78px);
				line-height: 1.0;
				letter-spacing: -0.01em;
			}
			.info-title .typer2 { position: relative; display: inline-block; white-space: pre-line; }
			.info-title .typer-ghost { visibility: hidden; }
			.info-title .typer-live { position: absolute; inset: 0; }
			.info-title .caret {
				display: inline-block;
				width: 0.045em; height: 0.78em;
				background: currentColor;
				margin-left: 0.04em;
				vertical-align: -0.04em;
				animation: caretBlink 0.9s steps(1, end) infinite;
			}
			.info-title .caret.done { animation: none; opacity: 0; }

			.info-sub {
				margin-top: 22px;
				color: var(--muted);
				font-size: clamp(15px, 1.25vw, 18px);
				letter-spacing: 0.01em;
			}

			.cat-list {
				margin-top: 40px;
				list-style: none;
				border-top: 1px solid rgba(75,69,64,0.16);
			}
			.cat-list li {
				display: flex;
				align-items: baseline;
				gap: 18px;
				padding: 17px 2px;
				border-bottom: 1px solid rgba(75,69,64,0.16);
				overflow: hidden;
			}
			.cat-list .cat-idx {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #B7AC9B;
				min-width: 26px;
			}
			.cat-list .cat-name {
				font-size: clamp(16px, 1.5vw, 20px);
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--ink);
			}
			/* staggered reveal */
			.reveal-up { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.2,0.7,0.2,1), transform 0.7s cubic-bezier(0.2,0.7,0.2,1); }
			.info-block.reveal .reveal-up { opacity: 1; transform: none; }
			.info-block.reveal .info-sub { transition-delay: 0.05s; }
			.info-block.reveal .cat-list li:nth-child(1) .cat-line { transition-delay: 0.18s; }
			.info-block.reveal .cat-list li:nth-child(2) .cat-line { transition-delay: 0.30s; }
			.info-block.reveal .cat-list li:nth-child(3) .cat-line { transition-delay: 0.42s; }
			.cat-line { display: flex; align-items: baseline; gap: 18px; width: 100%; transform: translateY(110%); transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1); }
			.info-block.reveal .cat-line { transform: none; }
			@media (prefers-reduced-motion: reduce) {
				.reveal-up, .cat-line { transition: none; opacity: 1; transform: none; }
			}

			/* ============ SECTION: FINISH LIBRARY — diagonal card stack (light) ============ */
			.finishes {
				position: relative;
				background: var(--paper);
				color: var(--ink);
				margin-top: 25vh;
			}

			.fin-stage {
				position: sticky;
				top: 0;
				height: 100vh;
				overflow: hidden;
				background: var(--paper);
			}

			/* heading — anchored top-LEFT */
			.fin-head {
				position: absolute;
				top: clamp(40px, 7vh, 86px);
				left: clamp(28px, 5vw, 84px);
				z-index: 3000;
				pointer-events: none;
				max-width: 60vw;
				transition: opacity 0.35s ease;
			}
			.fin-eyebrow {
				font-size: clamp(28px, 3vw, 46px);
				font-family: 'Cormorant', serif;
				font-weight: 500;
				letter-spacing: 0.005em;
				color: var(--taupe);
				line-height: 1.05;
			}
			.fin-sub {
				margin-top: 10px;
				font-size: 13px;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #A2937F;
			}

			.fin-hint {
				position: absolute;
				bottom: 34px;
				left: 50%;
				transform: translateX(-50%);
				font-size: 12px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #B3A795;
				z-index: 3000;
				pointer-events: none;
				white-space: nowrap;
				transition: opacity 0.4s ease;
			}

			/* opaque backdrop revealed when a finish is opened */
			.fin-backdrop {
				position: absolute;
				inset: 0;
				background: #EFEAE1;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s ease;
				z-index: 1500;
			}

			.fin-cards {
				position: absolute;
				inset: 0;
				perspective: 1700px;
				perspective-origin: 50% 50%;
				z-index: 1600;
			}

			.fcard {
				position: absolute;
				left: 50%;
				top: 50%;
				width: min(27vw, 400px);
				aspect-ratio: 4 / 5;
				border-radius: 7px;
				overflow: hidden;
				background: #E8E2D8;
				cursor: pointer;
				box-shadow: 0 30px 80px rgba(75, 69, 64, 0.30);
				will-change: transform, opacity;
			}
			.fcard img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				-webkit-user-drag: none;
				user-select: none;
			}
			.fcard-label {
				position: absolute;
				left: 14px;
				bottom: 14px;
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: #5E574E;
				background: rgba(253, 252, 250, 0.88);
				backdrop-filter: blur(6px);
				padding: 7px 12px;
				border-radius: 6px;
				pointer-events: none;
				white-space: nowrap;
			}

			/* open / focus states */
			.fin-stage.open .fcard,
			.fin-stage.closing .fcard { transition: transform 0.8s cubic-bezier(0.22, 0.8, 0.2, 1), opacity 0.5s ease; }
			.fcard.focus { box-shadow: 0 50px 130px rgba(75, 69, 64, 0.42); }

			/* detail panel */
			.fin-detail {
				position: absolute;
				top: 50%;
				right: clamp(28px, 7vw, 130px);
				width: min(34vw, 400px);
				transform: translateY(-46%);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
				z-index: 2700;
			}
			.fin-stage.open .fin-detail {
				opacity: 1;
				transform: translateY(-50%);
				transition-delay: 0.35s;
				pointer-events: auto;
			}
			.fin-detail .fd-series {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: #A2937F;
			}
			.fin-detail h3 {
				margin-top: 10px;
				font-family: 'Cormorant', serif;
				font-weight: 500;
				font-size: clamp(40px, 3.6vw, 58px);
				line-height: 1.02;
				color: var(--taupe);
			}
			.fin-detail .fd-desc {
				margin-top: 16px;
				font-size: 15px;
				line-height: 1.6;
				color: var(--muted);
				text-wrap: pretty;
			}
			.fin-detail .fd-specs {
				margin-top: 24px;
				border-top: 1px solid rgba(75, 69, 64, 0.16);
			}
			.fin-detail .fd-specs > div {
				display: flex;
				justify-content: space-between;
				gap: 18px;
				padding: 11px 0;
				border-bottom: 1px solid rgba(75, 69, 64, 0.16);
				font-size: 14px;
			}
			.fin-detail .fd-specs dt { color: #998F82; }
			.fin-detail .fd-specs dd { font-weight: 600; color: var(--ink); text-align: right; white-space: nowrap; }

			/* close button */
			.fin-close {
				position: absolute;
				top: 32px;
				right: 36px;
				width: 46px;
				height: 46px;
				border-radius: 50%;
				border: 1px solid rgba(75, 69, 64, 0.22);
				background: rgba(253, 252, 250, 0.9);
				color: #5E574E;
				font-size: 20px;
				line-height: 1;
				cursor: pointer;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease, background 0.3s ease;
				z-index: 3000;
			}
			.fin-stage.open .fin-close { opacity: 1; pointer-events: auto; }
			.fin-close:hover { background: #fff; }

			/* ============ FOOTER ============ */
			footer {
				background: #3E3833;
				color: #fff;
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}
			footer::before {
				content: "";
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.16), transparent 70%);
				pointer-events: none;
			}
			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}
			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}
			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.footer-logo {
				height: 44px;
				width: auto;
				display: block;
			}
			footer .footer-tagline {
				font-size: 0.9rem;
				font-weight: 400;
				color: rgba(255, 255, 255, 0.78);
			}
			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}
			.footer-nav {
				display: flex;
				gap: 1.2rem;
				flex-wrap: wrap;
			}
			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-size: 0.84rem;
				font-weight: 400;
				transition: color 0.3s;
			}
			.footer-nav a:hover { color: #fff; }
			footer .footer-copy {
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.45);
			}

			@media (max-width: 1100px) {
				.nav-links { display: none; }
				.hero-grid { flex-direction: column; align-items: stretch; padding: 0; }
				.hero-copy {
					flex: none;
					margin: 20px auto 0;
					max-width: 560px;
					padding: 0 clamp(20px, 6vw, 48px);
				}
				.hero-art {
					flex: none;
					align-self: center;
					margin: 18px 0 0;
					padding: 0 12px 12px;
					width: 100%;
					max-width: 780px;
				}
				.hero-art canvas { max-height: 44vh; margin: 0 auto; }
				.resurface { grid-template-columns: 1fr; padding: 48px clamp(16px, 5vw, 32px); }
				.fcard { width: min(56vw, 360px); }
				.fin-head { max-width: 80vw; }
				.fin-detail {
					right: 50%;
					transform: translate(50%, 0);
					top: auto;
					bottom: 22px;
					width: min(88vw, 420px);
					background: rgba(253, 252, 250, 0.95);
					border: 1px solid rgba(75, 69, 64, 0.1);
					border-radius: 14px;
					padding: 18px 22px 20px;
				}
				.fin-stage.open .fin-detail { transform: translate(50%, 0); }
				.fin-detail h3 { font-size: 32px; }
				.fin-detail .fd-desc { display: none; }
			}
		</style>
	</head>
	<body>

		<!-- ============ HERO ============ -->
		<header class="hero">
			<nav class="nav">
				<a class="logo" href="/" aria-label="Renuva">
					<Image src={renuvamain} alt="Renuva" width={550} loading="eager" />
				</a>
				<div class="nav-right">
					<div class="nav-links">
						<a href="/about">About Us</a>
						<a href="/distributor">Distributor</a>
						<a href="/gallery">Gallery</a>
					</div>
					<a class="contact-btn" href="/contact">Contact Us</a>
				</div>
			</nav>

			<div class="hero-grid" style="font-weight: 500">
				<div class="hero-copy">
					<p class="eyebrow">Premium Architectural Vinyl</p>
					<h1 aria-label="Renew. Don't replace."><span class="typer" id="heroTyper" aria-hidden="true">Renew. Don't replace.</span></h1>
					<a class="cta-btn" href="/distributor">DISTRIBUTOR INFO</a>
				</div>

				<div class="hero-art" aria-hidden="true">
					<canvas id="heroKitchen"></canvas>
				</div>
			</div>
		</header>

		<!-- ============ SECTION: FINISH LIBRARY ============ -->
		<section class="finishes" id="finishes">
			<div class="fin-stage" id="finStage">
				<div class="fin-head">
					<p class="fin-eyebrow">The Finish Library</p>
					<p class="fin-sub">Ten architectural films. One surface at a time.</p>
				</div>
				<div class="fin-backdrop" id="finBackdrop"></div>
				<div class="fin-cards" id="finCards"></div>
				<p class="fin-hint" id="finHint">Scroll to explore · Click a finish</p>
				<div class="fin-detail" id="finDetail"></div>
