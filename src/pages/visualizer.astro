---
import SiteHeader from '../components/SiteHeader.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/styles/renuva-visualizer.css" />
		<title>Visualizer - Renuva</title>
		<style>
			:root {
				--very-dark-brown: #262D26;
				--dark-brown: #5E635D;
				--brown: #8D7C6E;
				--light-brown: #ADB69F;
				--cream: #F5F4EF;
				--white: #FFFFFF;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: "Inter", "Segoe UI", sans-serif;
				background: linear-gradient(180deg, #ffffff, var(--cream));
				color: var(--very-dark-brown);
			}

			html, body {
				overflow-x: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			nav {
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}

			nav a {
				text-decoration: none;
				color: var(--dark-brown);
				font-family: "Playfair Display", serif;
				font-weight: 500;
				font-size: 0.95rem;
				letter-spacing: 0.02em;
				padding: 0.42rem 0.85rem;
				border-radius: 8px;
				transition: color 0.3s, background 0.3s;
			}

			nav a:not(.nav-cta) { position: relative; }

			nav a:not(.nav-cta)::after {
				content: "";
				position: absolute;
				left: 1.2rem;
				right: 1.2rem;
				bottom: 0.2rem;
				height: 1px;
				background: var(--brown);
				transform: scaleX(0);
				transform-origin: left center;
				transition: transform 0.35s ease;
			}

			nav a:not(.nav-cta):hover::after { transform: scaleX(1); }

			nav a:hover {
				color: var(--very-dark-brown);
			}

			nav a.active {
				color: var(--very-dark-brown);
			}

			nav .nav-cta {
				background: var(--brown);
				color: var(--white);
				padding: 0.46rem 1.1rem;
				border-radius: 50px;
				font-family: "Inter", sans-serif;
				font-weight: 600;
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				transition: background 0.3s, transform 0.25s;
			}

			nav .nav-cta:hover {
				background: var(--very-dark-brown);
				transform: translateY(-1px);
			}

			main {
				max-width: 1120px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem 4.5rem; /* extra room between the visualizer and the footer */
			}

			.hero {
				margin-bottom: 1.8rem;
			}

			h1 {
				font-family: "Playfair Display", Georgia, serif;
				font-size: clamp(1.6rem, 3.75vw, 2.7rem);
				line-height: 1.08;
				letter-spacing: -0.01em;
				color: var(--very-dark-brown);
				margin-bottom: 0.7rem;
			}

			.hero p {
				max-width: 62ch;
				color: var(--dark-brown);
				line-height: 1.7;
			}

			.steps {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem 2rem;
				margin: 0 0 1.6rem;
				padding: 0;
				list-style: none;
			}

			.steps li {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--dark-brown);
				font-size: 0.88rem;
			}

			.steps .n {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 24px;
				border-radius: 999px;
				background: var(--brown);
				color: var(--white);
				font-weight: 600;
				font-size: 0.74rem;
			}

			footer {
				background: #554B43;
				color: var(--white);
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}

			footer::before {
				content: '';
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.2), transparent 70%);
				pointer-events: none;
			}

			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}

			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.footer-logo {
				height: 44px;
				width: auto;
				display: block;
			}

			.footer-tagline {
				font-family: 'Inter', sans-serif;
				font-size: 0.9rem;
				font-weight: 300;
				color: rgba(255, 255, 255, 0.78);
			}

			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}

			.footer-nav {
				display: flex;
				gap: 1.2rem;
				flex-wrap: wrap;
			}

			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-size: 0.84rem;
				font-weight: 400;
				transition: color 0.3s;
			}

			.footer-nav a:hover { color: var(--white); }

			.footer-copy {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.45);
			}

			@media (max-width: 768px) {
				nav {
					width: auto;
					justify-content: flex-start;
					flex-wrap: nowrap;
					overflow-x: auto;
					-webkit-overflow-scrolling: touch;
					scrollbar-width: none;
					flex: 1 1 auto;
				}
				nav::-webkit-scrollbar { display: none; }
				nav a {
					white-space: nowrap;
					font-size: 0.78rem;
					padding: 0.3rem 0.5rem;
				}
				nav .nav-cta {
					margin-left: 0.2rem;
					padding: 0.34rem 0.7rem;
					font-size: 0.64rem;
				}

				.footer-top {
					grid-template-columns: 1fr;
					text-align: center;
				}

				.footer-brand {
					justify-content: center;
				}

				.footer-bottom {
					justify-content: center;
					text-align: center;
				}
			}

			@media (max-width: 600px) {
				main {
					padding-top: 2.4rem;
				}
			}
		</style>
	</head>
	<body>
		<SiteHeader active="/visualizer" />

		<main>
			<section class="hero">
				<h1>Visualizer</h1>
				<p>
					See your own kitchen renewed before any work begins. Upload a photo,
					choose any of our finishes, and we'll render your cabinets wrapped
					in it. Photorealistic, in about a minute.
				</p>
			</section>

			<ol class="steps" aria-label="How it works">
				<li><span class="n">1</span> Upload a photo of your kitchen</li>
				<li><span class="n">2</span> Pick a Renuva finish</li>
				<li><span class="n">3</span> Generate your preview</li>
			</ol>

			<section id="visualizer" aria-label="Kitchen visualizer"></section>
		</main>

		<script is:inline src="/scripts/renuva-visualizer.js"></script>
		<script is:inline>
			RenuvaVisualizer.mount(document.getElementById('visualizer'));
		</script>
		<footer>
			<div class="footer-shell">
				<div class="footer-top">
					<div class="footer-brand">
						<img class="footer-logo" src="/assets/images/LOGO_Colorful_Colorful_Colorful_White.png" alt="Renuva logo" />
						<p class="footer-tagline">Transform existing surfaces. Renew beautifully.</p>
					</div>
				</div>
				<div class="footer-bottom">
					<nav class="footer-nav">
						<a href="/">Home</a>
						<a href="/about">About Us</a>
						<a href="/distributor">Distributor</a>
						<a href="/finishes">Finishes</a>
						<a href="/visualizer">Visualizer</a>
						<a href="/gallery">Gallery</a>
						<a href="/contact">Contact</a>
					</nav>
					<p class="footer-copy">&copy; 2026 Renuva Architectural Surfaces. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
