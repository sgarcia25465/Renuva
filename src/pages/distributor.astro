---
import SiteHeader from '../components/SiteHeader.astro';

const regions = [
	{
		name: 'United States',
		distributors: [
			{ name: 'SurfaceSupply', url: 'https://surfacesupply.com', display: 'surfacesupply.com' },
		],
	},
	{ name: 'Europe & Asia', distributors: [] },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Cormorant:wght@500;600&family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Distributors - Renuva</title>
		<style>
			:root {
				--very-dark-brown: #262D26;
				--dark-brown: #5E635D;
				--brown: #8D7C6E;
				--light-brown: #ADB69F;
				--cream: #F5F4EF;
				--white: #FFFFFF;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: "Inter", "Segoe UI", sans-serif;
				background: linear-gradient(180deg, #ffffff, var(--cream));
				color: var(--very-dark-brown);
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			/* Renuva brand pattern, whisper-light, sides only: masked away from
			   the center so the content column stays clean */
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -1;
				background: url("/assets/images/pattern-design.png") center/560px repeat;
				opacity: 0.09;
				pointer-events: none;
				/* clear zone anchored to the 860px content column (plus breathing
				   room) so the pattern never runs under the text or hairlines */
				-webkit-mask-image: linear-gradient(to right, black 0%, black 7%, transparent calc(50% - 500px), transparent calc(50% + 500px), black 93%, black 100%);
				mask-image: linear-gradient(to right, black 0%, black 7%, transparent calc(50% - 500px), transparent calc(50% + 500px), black 93%, black 100%);
			}

			html, body {
				overflow-x: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			main {
				width: 100%;
				max-width: 860px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem 4.5rem;
				flex: 1;
			}

			.hero {
				margin-bottom: 2.2rem;
				text-align: center;
			}

			.hero p {
				margin: 0 auto;
			}

			h1 {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: clamp(1.9rem, 4.2vw, 3.1rem);
				line-height: 1.02;
				letter-spacing: 0.005em;
				color: #8C7766; /* landing hero taupe */
				margin-bottom: 0.7rem;
			}

			.hero p {
				max-width: 62ch;
				color: var(--dark-brown);
				line-height: 1.7;
			}

			/* ── distributors by region ── */
			.region-block {
				padding: 1.6rem 0;
				border-top: 1px solid rgba(141, 124, 110, 0.2);
			}

			.region-block:last-of-type {
				border-bottom: 1px solid rgba(141, 124, 110, 0.2);
				margin-bottom: 3rem;
			}

			.region-name {
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: #8C7766;
				margin-bottom: 0.7rem;
			}

			.dist-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.dist-logo {
				height: clamp(34px, 4.5vw, 48px);
				width: auto;
				display: block;
				/* the logo file has a white background; multiply melts it into the page */
				mix-blend-mode: multiply;
			}

			.dist-link {
				font-size: 0.92rem;
				font-weight: 600;
				color: var(--brown);
				text-decoration: none;
			}

			.dist-link:hover {
				color: var(--very-dark-brown);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.coming-soon {
				color: var(--dark-brown);
				font-size: 0.95rem;
				line-height: 1.6;
			}

			/* ── 3D buttons (matches the landing) ── */
			.btn-3d {
				display: inline-block;
				border: none;
				cursor: pointer;
				text-decoration: none;
				text-align: center;
				color: #fff;
				background: linear-gradient(to bottom, #99836F, #8C7766);
				font: 600 0.85rem "Inter", sans-serif;
				padding: 0.7rem 1.4rem;
				border-radius: 8px;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 0 #66554A, 0 5px 12px rgba(140, 119, 102, 0.3);
				transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
			}

			.btn-3d:hover {
				background: linear-gradient(to bottom, #8C7766, #7A6657);
				transform: translateY(-1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 3px 0 #66554A, 0 7px 16px rgba(140, 119, 102, 0.35);
			}

			.btn-3d:active {
				transform: translateY(1px);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 1px 0 #66554A, 0 3px 8px rgba(140, 119, 102, 0.25);
			}

			/* ── become a distributor ── */
			.become {
				text-align: center;
			}

			.become h2 {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 600;
				font-size: clamp(1.5rem, 2.7vw, 1.9rem);
				color: #8C7766;
				margin-bottom: 0.35rem;
			}

			.become > p {
				color: var(--dark-brown);
				font-size: 0.88rem;
				line-height: 1.7;
				max-width: 56ch;
				margin: 0 auto 1.1rem;
			}

			.become-form {
				display: none;
				margin-top: 1.4rem;
				padding-top: 1.4rem;
				border-top: 1px solid rgba(141, 124, 110, 0.18);
				text-align: left; /* the intro is centered; keep form fields readable */
			}

			.become-form.open { display: block; }

			.form-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 12px;
				margin-bottom: 12px;
			}

			.field { display: flex; flex-direction: column; gap: 5px; }
			.field.full { grid-column: 1 / -1; }

			.field label {
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--dark-brown);
				letter-spacing: 0.03em;
			}

			.field input,
			.field textarea {
				font: 400 0.92rem "Inter", sans-serif;
				color: var(--very-dark-brown);
				background: #fdfcfa;
				border: 1px solid rgba(141, 124, 110, 0.3);
				border-radius: 9px;
				padding: 0.65rem 0.8rem;
				outline: none;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.field textarea { resize: vertical; min-height: 96px; }

			.field input:focus,
			.field textarea:focus {
				border-color: var(--brown);
				box-shadow: 0 0 0 3px rgba(141, 124, 110, 0.14);
			}

			.form-msg {
				margin-top: 0.9rem;
				padding: 0.65rem 0.85rem;
				border-radius: 9px;
				font-size: 0.88rem;
				display: none;
			}

			.form-msg.ok {
				display: block;
				background: #eef2e9;
				border: 1px solid #c4d0b8;
				color: #3d4a35;
			}

			.form-msg.err {
				display: block;
				background: #f7ece8;
				border: 1px solid #e0c2b5;
				color: #7c4a33;
			}

			/* ── footer ── */
			footer {
				background: #554B43;
				color: var(--white);
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}

			footer::before {
				content: '';
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.2), transparent 70%);
				pointer-events: none;
			}

			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}

			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.footer-logo {
				height: 44px;
				width: auto;
				display: block;
			}

			.footer-tagline {
				font-family: 'Inter', sans-serif;
				font-size: 0.9rem;
				font-weight: 300;
				color: rgba(255, 255, 255, 0.78);
			}

			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}

			.footer-nav {
				display: flex;
				gap: 1.2rem;
				flex-wrap: wrap;
			}

			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-size: 0.84rem;
				transition: color 0.3s ease;
			}

			.footer-nav a:hover { color: #fff; }

			.footer-copy {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.48);
			}

			@media (max-width: 768px) {
				main { padding: 2.4rem 1rem 3.5rem; }
				.form-grid { grid-template-columns: 1fr; }
				.dist-row { align-items: flex-start; flex-direction: column; }
				.footer-brand { justify-content: center; }
				.footer-bottom { justify-content: center; text-align: center; }
			}
		</style>
	</head>
	<body>
		<SiteHeader active="/distributor" />

		<main>
			<section class="hero">
				<h1>Distributors</h1>
				<p>Renuva architectural film is available through our authorized distributors.</p>
			</section>

			<section aria-label="Authorized distributors">
				{regions.map((r) => (
					<div class="region-block">
						<p class="region-name">{r.name}</p>
						{r.distributors.length > 0 ? (
							r.distributors.map((d) => (
								<div class="dist-row">
									<img class="dist-logo" src="/assets/images/surfacesupply-logo.png" alt={d.name} loading="lazy" />
									<a class="dist-link" href={d.url} target="_blank" rel="noopener">{d.display} &#8599;</a>
								</div>
							))
						) : (
							<p class="coming-soon">Coming soon.</p>
						)}
					</div>
				))}
			</section>

			<section class="become" id="become" aria-label="Become a distributor">
				<h2>Become a distributor today</h2>
				<p>Interested in carrying Renuva in your region? Tell us a little about your business and we'll be in touch.</p>
				<button type="button" class="btn-3d" id="becomeToggle">Become a Distributor</button>

				<form
					class="become-form"
					id="becomeForm"
					name="become-a-distributor"
					method="POST"
					data-netlify="true"
					netlify-honeypot="bot-field"
				>
					<input type="hidden" name="form-name" value="become-a-distributor" />
					<p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
					<div class="form-grid">
						<div class="field">
							<label for="bf-name">Name</label>
							<input id="bf-name" name="name" type="text" required autocomplete="name" />
						</div>
						<div class="field">
							<label for="bf-company">Company</label>
							<input id="bf-company" name="company" type="text" required autocomplete="organization" />
						</div>
						<div class="field">
							<label for="bf-email">Email</label>
							<input id="bf-email" name="email" type="email" required autocomplete="email" />
						</div>
						<div class="field">
							<label for="bf-region">Region</label>
							<input id="bf-region" name="region" type="text" placeholder="e.g. Florida, USA" />
						</div>
						<div class="field full">
							<label for="bf-message">Message</label>
							<textarea id="bf-message" name="message" placeholder="Tell us about your business." />
						</div>
					</div>
					<button type="submit" class="btn-3d">Send</button>
					<p class="form-msg" id="becomeMsg"></p>
				</form>
			</section>
		</main>

		<footer>
			<div class="footer-shell">
				<div class="footer-top">
					<div class="footer-brand">
						<img class="footer-logo" src="/assets/images/LOGO_Colorful_Colorful_Colorful_White.png" alt="Renuva logo" />
						<p class="footer-tagline">Transform existing surfaces. Renew beautifully.</p>
					</div>
				</div>
				<div class="footer-bottom">
					<nav class="footer-nav">
						<a href="/">Home</a>
						<a href="/about">About Us</a>
						<a href="/distributor">Distributors</a>
						<a href="/finishes">Finishes</a>
						<a href="/visualizer">Visualizer</a>
						<a href="/gallery">Gallery</a>
						<a href="/contact">Contact</a>
					</nav>
					<p class="footer-copy">&copy; 2026 Renuva Architectural Surfaces. All rights reserved.</p>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById('becomeToggle');
			const form = document.getElementById('becomeForm');
			const msg = document.getElementById('becomeMsg');

			toggle.addEventListener('click', () => {
				form.classList.toggle('open');
				if (form.classList.contains('open')) {
					form.querySelector('input[name="name"]').focus();
				}
			});

			// Inline submit so visitors stay on the page (Netlify Forms AJAX pattern).
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				msg.className = 'form-msg';
				const data = new FormData(form);
				try {
					const res = await fetch('/', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams(data).toString(),
					});
					if (!res.ok) throw new Error();
					form.reset();
					msg.textContent = "Thanks! We'll get back to you shortly.";
					msg.classList.add('ok');
				} catch {
					msg.textContent = "Something went wrong sending your inquiry. Please email contact@renuva.com directly.";
					msg.classList.add('err');
				}
			});
		</script>
	</body>
</html>
