---
/* Each tile is one of our project kitchens shown in a specific Renuva finish,
   rendered from that finish's own swatch — so what you see is the finish it
   says it is. Hand-shuffled so two tiles from the same kitchen, or two similar
   tones, never sit next to each other.
   Position in this list = grid-area g1..g20 in the CSS. */
import SiteHeader from '../components/SiteHeader.astro';
import Seo from '../components/Seo.astro';
const NAMES = {
	PW1512: 'Cream Ash', PW1514: 'Sand Oak', PW1516: 'Honey Oak',
	PW1518: 'Golden Rift Oak', PW1520: 'Amber Oak', PW1522: 'Rosewood Mahogany',
	RW1414: 'Cream Painted Wood', RW1416: 'Dove Grey Painted Wood',
	RW1418: 'Bright White Painted Wood',
	FP1840: 'White Linen Weave', FP1842: 'Grey Linen Weave',
	MTS1308: 'Slate Grey Soft Matte', HG1630: 'Pure White Gloss', HG1634: 'Greige Gloss',
	MT1701: 'Pure White Matte', MT1707: 'Pale Grey Matte', MT1709: 'Stone Grey Matte',
	MT1711: 'Charcoal Matte', ME1215: 'Pearl Silver Metal',
	ST1105: 'Cream Onyx Marble', ST1107: 'Carrara White Marble', ST1109: 'Cloud White Marble'
};
const order = [
	'PW1518', 'MT1711', 'ST1107', 'RW1416', 'PW1520',
	'HG1630', 'FP1842', 'PW1514', 'ST1105', 'MT1707',
	'ME1215', 'PW1522', 'RW1414', 'MT1709', 'PW1516',
	'FP1840', 'HG1634', 'MT1701', 'MTS1308', 'ST1109'
];
const tiles = order.map((code) => ({
	code,
	name: NAMES[code],
	src: `/assets/showcase/${code}.jpg`
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/newfavicon.png?v=3" />
		<link rel="shortcut icon" href="/newfavicon.png?v=3" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Cormorant:wght@500;600&family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<Seo
			title="Gallery - Renuva"
			description="Kitchens renewed with Renuva architectural film — cabinets wrapped in premium wood, painted wood, marble, metal, matte and high gloss finishes."
		/>
		<style>
			:root {
				--very-dark-brown: #262D26;
				--dark-brown: #5E635D;
				--brown: #8D7C6E;
				--light-brown: #ADB69F;
				--cream: #F5F4EF;
				--white: #FFFFFF;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: "Inter", "Segoe UI", sans-serif;
				background: linear-gradient(180deg, #ffffff, var(--cream));
				color: var(--very-dark-brown);
			}

			html, body {
				overflow-x: hidden;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			nav {
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}

			nav a {
				text-decoration: none;
				color: var(--dark-brown);
				font-family: "Playfair Display", serif;
				font-weight: 500;
				font-size: 0.95rem;
				letter-spacing: 0.02em;
				padding: 0.42rem 0.85rem;
				border-radius: 8px;
				transition: color 0.3s, background 0.3s;
			}

			nav a:not(.nav-cta) { position: relative; }

			nav a:not(.nav-cta)::after {
				content: "";
				position: absolute;
				left: 1.2rem;
				right: 1.2rem;
				bottom: 0.2rem;
				height: 1px;
				background: var(--brown);
				transform: scaleX(0);
				transform-origin: left center;
				transition: transform 0.35s ease;
			}

			nav a:not(.nav-cta):hover::after { transform: scaleX(1); }

			nav a:hover {
				color: var(--very-dark-brown);
			}

			nav .nav-cta {
				background: var(--brown);
				color: var(--white);
				padding: 0.46rem 1.1rem;
				border-radius: 50px;
				font-family: "Inter", sans-serif;
				font-weight: 600;
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				transition: background 0.3s, transform 0.25s;
			}

			nav .nav-cta:hover {
				background: var(--very-dark-brown);
				transform: translateY(-1px);
			}

			main {
				max-width: 1120px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem 4.5rem;
			}

			.hero {
				margin-bottom: 1.8rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
			}

			h1 {
				font-family: "Cormorant", Georgia, serif;
				font-weight: 500;
				font-size: clamp(1.9rem, 4.2vw, 3.1rem);
				line-height: 1.02;
				letter-spacing: 0.005em;
				color: #8C7766; /* landing hero taupe */
			}

			.own-gallery-link {
				font-size: 0.92rem;
				font-weight: 600;
				color: var(--brown);
				text-decoration: none;
			}

			.own-gallery-link:hover {
				color: var(--very-dark-brown);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			/* Mosaic: shapes are chosen per photo — wide slots for the frontal
			   cabinet runs, tall slots for vertical compositions, one 2×2 for
			   the bright oak kitchen — mapped to DOM order via g1..g20. */
			.gallery-grid {
				/* breakout: wider than the page column so the mosaic fills more of the viewport */
				width: min(1360px, calc(100vw - 3rem));
				margin-left: 50%;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				grid-template-rows: repeat(7, clamp(210px, 23vw, 300px));
				grid-template-areas:
					"g1  g1  g2  g3"
					"g1  g1  g2  g4"
					"g5  g5  g6  g7"
					"g8  g9  g10 g11"
					"g12 g12 g10 g13"
					"g14 g15 g16 g17"
					"g18 g18 g19 g20";
				gap: 7px;
			}

			.gallery-item:nth-child(1) { grid-area: g1; }
			.gallery-item:nth-child(2) { grid-area: g2; }
			.gallery-item:nth-child(3) { grid-area: g3; }
			.gallery-item:nth-child(4) { grid-area: g4; }
			.gallery-item:nth-child(5) { grid-area: g5; }
			.gallery-item:nth-child(6) { grid-area: g6; }
			.gallery-item:nth-child(7) { grid-area: g7; }
			.gallery-item:nth-child(8) { grid-area: g8; }
			.gallery-item:nth-child(9) { grid-area: g9; }
			.gallery-item:nth-child(10) { grid-area: g10; }
			.gallery-item:nth-child(11) { grid-area: g11; }
			.gallery-item:nth-child(12) { grid-area: g12; }
			.gallery-item:nth-child(13) { grid-area: g13; }
			.gallery-item:nth-child(14) { grid-area: g14; }
			.gallery-item:nth-child(15) { grid-area: g15; }
			.gallery-item:nth-child(16) { grid-area: g16; }
			.gallery-item:nth-child(17) { grid-area: g17; }
			.gallery-item:nth-child(18) { grid-area: g18; }
			.gallery-item:nth-child(19) { grid-area: g19; }
			.gallery-item:nth-child(20) { grid-area: g20; }

			.gallery-item {
				display: block;
				border-radius: 10px;
				overflow: hidden;
				cursor: zoom-in;
			}

			.gallery-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
			}

			.gallery-item:hover img { transform: scale(1.03); }

			.lightbox {
				position: fixed;
				inset: 0;
				background: rgba(24, 22, 20, 0.93);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 2000;
				cursor: zoom-out;
			}

			.lightbox.open { display: flex; }

			.lightbox img {
				max-width: 92vw;
				max-height: 84vh;
				border-radius: 6px;
				box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
			}

			/* finish name on each tile, revealed on hover */
			.gallery-item { position: relative; }
			.gi-tag {
				position: absolute;
				left: 12px;
				bottom: 12px;
				padding: 6px 11px;
				border-radius: 999px;
				background: rgba(24, 22, 20, 0.55);
				backdrop-filter: blur(4px);
				color: #fff;
				font-size: 12px;
				font-weight: 500;
				letter-spacing: 0.01em;
				opacity: 0;
				transform: translateY(4px);
				transition: opacity 0.25s ease, transform 0.25s ease;
				pointer-events: none;
			}
			.gallery-item:hover .gi-tag,
			.gallery-item:focus-visible .gi-tag { opacity: 1; transform: translateY(0); }
			@media (hover: none) {
				.gi-tag { opacity: 1; transform: none; }
			}
			@media (prefers-reduced-motion: reduce) {
				.gi-tag { transition: none; }
			}

			/* finish credit under the enlarged photo */
			.lb-credit {
				position: absolute;
				left: 50%;
				bottom: clamp(18px, 4vh, 40px);
				transform: translateX(-50%);
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 10px 18px;
				border-radius: 999px;
				background: rgba(253, 252, 250, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.18);
				backdrop-filter: blur(6px);
				cursor: default;
			}
			.lb-credit[hidden] { display: none; }
			.lb-credit-label {
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.55);
			}
			.lb-credit-link {
				font-size: 14px;
				font-weight: 500;
				color: #fff;
				text-decoration: none;
				border-bottom: 1px solid rgba(255, 255, 255, 0.35);
				padding-bottom: 1px;
				cursor: pointer;
				transition: border-color 0.2s ease;
			}
			.lb-credit-link:hover { border-color: #fff; }

			footer {
				background: #554B43;
				color: var(--white);
				padding: 3rem 2rem 2rem;
				position: relative;
				overflow: hidden;
			}

			footer::before {
				content: '';
				position: absolute;
				top: -120px;
				right: -120px;
				width: 280px;
				height: 280px;
				background: radial-gradient(circle, rgba(215, 193, 184, 0.2), transparent 70%);
				pointer-events: none;
			}

			.footer-shell {
				max-width: 1100px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			.footer-top {
				display: flex;
				justify-content: center;
				align-items: center;
				text-align: center;
				gap: 0.8rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.16);
			}

			.footer-brand {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.footer-logo {
				height: 44px;
				width: auto;
				display: block;
			}

			footer .footer-tagline {
				font-family: 'Inter', sans-serif;
				font-size: 0.9rem;
				font-weight: 300;
				color: rgba(255, 255, 255, 0.78);
			}

			.footer-bottom {
				margin-top: 1rem;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.9rem;
				text-align: center;
			}

			.footer-nav {
				display: flex;
				gap: 1.2rem;
				flex-wrap: wrap;
			}

			.footer-nav a {
				color: rgba(255, 255, 255, 0.75);
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-size: 0.84rem;
				font-weight: 400;
				transition: color 0.3s;
			}

			.footer-nav a:hover { color: var(--white); }

			footer .footer-copy {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				color: rgba(255, 255, 255, 0.45);
			}
			.footer-family {
				margin-top: 0.9rem;
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				text-align: center;
			}
			.footer-family a {
				color: rgba(255, 255, 255, 0.5);
				text-decoration: none;
				font-size: 0.76rem;
				font-weight: 400;
				transition: color 0.3s;
			}
			.footer-family a:hover { color: #fff; }

			@media (max-width: 900px) {
				.gallery-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					grid-template-rows: repeat(14, clamp(190px, 30vw, 280px));
					grid-template-areas:
						"g1  g1"
						"g1  g1"
						"g2  g3"
						"g2  g4"
						"g5  g5"
						"g6  g7"
						"g8  g9"
						"g10 g11"
						"g10 g13"
						"g12 g12"
						"g14 g15"
						"g16 g19"
						"g18 g18"
						"g17 g20";
				}
			}

			@media (max-width: 768px) {
				nav {
					width: auto;
					justify-content: flex-start;
					flex-wrap: nowrap;
					overflow-x: auto;
					-webkit-overflow-scrolling: touch;
					scrollbar-width: none;
					flex: 1 1 auto;
				}
				nav::-webkit-scrollbar { display: none; }
				nav a {
					white-space: nowrap;
					font-size: 0.78rem;
					padding: 0.3rem 0.5rem;
				}
				nav .nav-cta {
					margin-left: 0.2rem;
					padding: 0.34rem 0.7rem;
					font-size: 0.64rem;
				}

				.footer-top {
					grid-template-columns: 1fr;
					text-align: center;
				}

				.footer-brand {
					justify-content: center;
				}

				.footer-bottom {
					justify-content: center;
					text-align: center;
				}
			}

			@media (max-width: 600px) {
				main {
					padding-top: 2.4rem;
				}

				.gallery-grid {
					grid-template-columns: 1fr;
					grid-template-rows: none;
					grid-template-areas: none;
				}

				.gallery-grid .gallery-item {
					grid-area: auto;
				}

				.gallery-grid .gallery-item img {
					height: auto;
					aspect-ratio: 4 / 5;
				}
			}
		footer {
			background: #554B43;
			color: var(--white);
			padding: 3rem 2rem 2rem;
			position: relative;
			overflow: hidden;
		}

		footer::before {
			content: "";
			position: absolute;
			top: -120px;
			right: -120px;
			width: 280px;
			height: 280px;
			background: radial-gradient(circle, rgba(215, 193, 184, 0.2), transparent 70%);
			pointer-events: none;
		}

		.footer-shell {
			max-width: 1100px;
			margin: 0 auto;
			position: relative;
			z-index: 1;
		}

		.footer-top {
			display: flex;
			justify-content: center;
			align-items: center;
			text-align: center;
			gap: 0.8rem;
			padding-bottom: 1.2rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.16);
		}

		.footer-brand {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.footer-logo {
			height: 44px;
			width: auto;
			display: block;
		}

		.footer-tagline {
			font-family: 'Inter', sans-serif;
			font-size: 0.9rem;
			font-weight: 300;
			color: rgba(255, 255, 255, 0.78);
		}

		.footer-bottom {
			margin-top: 1rem;
			display: flex;
			justify-content: center;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.9rem;
			text-align: center;
		}

		.footer-nav {
			display: flex;
			gap: 1.2rem;
			flex-wrap: wrap;
		}

		.footer-nav a {
			color: rgba(255, 255, 255, 0.75);
			text-decoration: none;
			font-family: 'Inter', sans-serif;
			font-size: 0.84rem;
			font-weight: 400;
			transition: color 0.3s;
		}

		.footer-nav a:hover {
			color: var(--white);
		}

		.footer-copy {
			font-family: 'Inter', sans-serif;
			font-size: 0.78rem;
			color: rgba(255, 255, 255, 0.45);
		}
		</style>
	</head>
	<body>
		<SiteHeader active="/gallery/" />

		<main>
			<section class="hero">
				<h1>Gallery</h1>
				<a class="own-gallery-link" href="/visualizer/">See your own gallery &#8599;</a>
			</section>

			<section class="gallery-grid" aria-label="Kitchens by finish">
				{tiles.map((t, i) => (
					<a
						class="gallery-item"
						href={t.src}
						data-code={t.code}
						data-name={t.name}
						aria-label={`View a kitchen in ${t.name} — ${t.code}`}
					>
						<img
							src={t.src}
							alt={`Kitchen cabinets in Renuva ${t.name} (${t.code})`}
							loading={i < 6 ? 'eager' : 'lazy'}
						/>
						<span class="gi-tag">{t.name}</span>
					</a>
				))}
			</section>
		</main>

		<div class="lightbox" id="lightbox" role="dialog" aria-label="Enlarged photo">
			<img id="lightboxImg" src="" alt="" />
			<div class="lb-credit" id="lbCredit" hidden>
				<span class="lb-credit-label">Finish</span>
				<a class="lb-credit-link" id="lbCreditLink" href=""></a>
			</div>
		</div>

		<script is:inline src="/scripts/renuva-finish-media.js"></script>
		<script>
			const items = Array.from(document.querySelectorAll('.gallery-item'));
			const box = document.getElementById('lightbox');
			const boxImg = document.getElementById('lightboxImg');
			let current = -1;

			const credit = document.getElementById('lbCredit');
			const creditLink = document.getElementById('lbCreditLink');

			function show(i) {
				current = (i + items.length) % items.length;
				const src = items[current].getAttribute('href');
				boxImg.src = src;

				/* credit the finish this kitchen is wearing, and let people jump
				   straight to it */
				const code = items[current].getAttribute('data-code');
				const name = items[current].getAttribute('data-name');
				if (code) {
					creditLink.textContent = name + ' · ' + code;
					creditLink.href = '/finishes#' + code;
					credit.hidden = false;
				} else {
					credit.hidden = true;
				}
				box.classList.add('open');
			}
			function hide() {
				box.classList.remove('open');
				current = -1;
			}

			items.forEach((el, i) => el.addEventListener('click', (e) => { e.preventDefault(); show(i); }));
			box.addEventListener('click', (e) => { if (e.target !== creditLink) hide(); });
			window.addEventListener('keydown', (e) => {
				if (current < 0) return;
				if (e.key === 'Escape') hide();
				else if (e.key === 'ArrowRight') show(current + 1);
				else if (e.key === 'ArrowLeft') show(current - 1);
			});
		</script>
		<footer>
			<div class="footer-shell">
				<div class="footer-top">
					<div class="footer-brand">
						<img class="footer-logo" src="/assets/images/LOGO_Colorful_Colorful_Colorful_White.png" alt="Renuva logo" />
						<p class="footer-tagline">Transform existing surfaces. Renew beautifully.</p>
					</div>
				</div>
				<div class="footer-bottom">
					<nav class="footer-nav">
						<a href="/">Home</a>
						<a href="/about/">About Us</a>
						<a href="/distributor/">Distributors</a>
						<a href="/finishes/">Finishes</a>
						<a href="/visualizer/">Visualizer</a>
						<a href="/gallery/">Gallery</a>
						<a href="/contact/">Contact</a>
					</nav>
					<p class="footer-copy">&copy; 2026 Renuva Architectural Surfaces. All rights reserved.</p>
				</div>
				<nav class="footer-family" aria-label="Where to buy Renuva">
					<a href="https://surfacesupply.com/collections/renuva-architectural-film" title="Shop Renuva architectural film at Surface Supply, the US distributor" target="_blank" rel="noopener">Buy Renuva in the US</a>
					<a href="https://surfacesupply.com" title="Surface Supply, architectural film distributor" target="_blank" rel="noopener">Surface Supply</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
